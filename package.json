{
  "name": "magma-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for Magma, the Maggioli Group Design System",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:authors": "node scripts/check-authors.mjs",
    "lint": "eslint src && stylelint \"src/**/*.css\"",
    "screenshots": "node scripts/screenshots.mjs",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/starlight": "0.42.10",
    "@fontsource/karla": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@iconsauce/core": "2.0.3",
    "@iconsauce/material-icons": "1.0.3",
    "@iconsauce/mdi-svg": "1.1.0",
    "@iconsauce/mgg-icons": "1.2.0",
    "@lobehub/icons-static-svg": "1.102.0",
    "@maggioli-design-system/design-tokens": "16.0.0",
    "@maggioli-design-system/icons": "1.95.0",
    "@maggioli-design-system/identity": "2.2.0",
    "@maggioli-design-system/magma": "2.12.0",
    "@maggioli-design-system/magma-angular": "2.12.0",
    "@maggioli-design-system/magma-react": "2.12.0",
    "@maggioli-design-system/styles": "17.7.0",
    "@maggioli-design-system/svg-icons": "4.6.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.7",
    "normalize.css": "8.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@html-eslint/parser": "0.67.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
