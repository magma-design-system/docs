---
// A pattern or a block running small, to see at a glance what it does: one of
// its previews (src/pages/example/[kind]/[id]/[preview].astro) in a frame of
// 720 by 450 pixels, scaled down to the width of its box (the script below):
// the stages of Magma are compositions narrower than a page, and on a screen
// as wide as a desktop their text would be too small to make out.
// Only a picture: the frame is inert, and the link around it, which takes a
// click on it to `href`, is hidden from assistive technologies and from the
// keyboard. The title next to it, on a card of the gallery
// (PatternGallery.astro), names the same page for everyone. The frame loads
// when it comes near the viewport, and follows the light or dark mode and the
// theme of the page.
interface Props {
  /** The page of the preview (previewHref() in src/lib/patterns.ts). */
  src: string;
  /** Names the frame. */
  title: string;
  /** Where a click on it leads. */
  href: string;
  class?: string;
}

const { src, title, href, class: className } = Astro.props;
---

<docs-mini-preview class:list={['block', className]}>
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class="relative block aspect-8/5 overflow-hidden rounded-lg border border-border-muted bg-surface-default shadow-sm transition-cosmetic hover:border-border-strong"
  >
    <iframe
      src={src}
      title={title}
      width="720"
      height="450"
      loading="lazy"
      tabindex="-1"
      inert
      class="pointer-events-none absolute start-0 top-0 origin-top-left border-0"
      data-mini-preview-frame
    ></iframe>
  </a>
</docs-mini-preview>

<script>
  // The classes and attributes of <html> that carry the mode and the theme, as
  // the preview page copies them before its first paint.
  const MODE = /^pref-mode-/;
  const ATTRIBUTES = ['data-magma-pref', 'data-theme-name'];

  class MiniPreview extends HTMLElement {
    private frame = this.querySelector<HTMLIFrameElement>('[data-mini-preview-frame]');
    private resize = new ResizeObserver(() => this.fit());
    private mode = new MutationObserver(() => this.sync());

    connectedCallback() {
      this.resize.observe(this);
      this.mode.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', ...ATTRIBUTES],
      });
      this.frame?.addEventListener('load', this.sync);
      this.fit();
    }

    disconnectedCallback() {
      this.resize.disconnect();
      this.mode.disconnect();
      this.frame?.removeEventListener('load', this.sync);
    }

    /** The screen scaled down to the width of the box. */
    private fit() {
      if (!this.frame || this.clientWidth === 0) return;
      this.frame.style.scale = String(this.clientWidth / Number(this.frame.width));
    }

    /** The mode and the theme of the page, also when they change after the load. */
    private sync = () => {
      const root = this.frame?.contentDocument?.documentElement;
      if (!root) return;
      const around = document.documentElement;
      root.classList.remove(...[...root.classList].filter((name) => MODE.test(name)));
      root.classList.add(...[...around.classList].filter((name) => MODE.test(name)));
      for (const name of ATTRIBUTES) {
        const value = around.getAttribute(name);
        if (value === null) root.removeAttribute(name);
        else root.setAttribute(name, value);
      }
    };
  }

  customElements.define('docs-mini-preview', MiniPreview);
</script>
