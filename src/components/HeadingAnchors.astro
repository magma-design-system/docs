---
// A click on the anchor of a heading (`data-heading-anchor`, ANCHOR in
// src/lib/markdown-text.mjs) also copies the address of the heading to the
// clipboard: its icon turns into a check for a moment, and screen readers hear
// it from the live region below. One per page, in the content
// (TwoColumnContent.astro), so its strings follow the language of the page.
const { t } = Astro.locals;
---

<span
  class="sr-only"
  role="status"
  data-anchor-live
  data-done={t('heading.linkCopied')}
  data-failed={t('heading.linkNotCopied')}
></span>

<script>
  const COPIED_ICON = 'mi/baseline/check';
  /** How long the anchor shows the check, in milliseconds. */
  const SHOWN = 1500;
  const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  const announce = (copied: boolean) => {
    const live = document.querySelector<HTMLElement>('[data-anchor-live]');
    if (!live) return;
    // Emptied first: the same text twice in a row would not be read again.
    live.textContent = '';
    requestAnimationFrame(() => {
      live.textContent = (copied ? live.dataset.done : live.dataset.failed) ?? '';
    });
  };

  const showCopied = (anchor: HTMLElement) => {
    anchor.dataset.anchorIcon ??= anchor.getAttribute('icon') ?? '';
    anchor.setAttribute('icon', COPIED_ICON);
    clearTimeout(timers.get(anchor));
    timers.set(
      anchor,
      setTimeout(() => anchor.setAttribute('icon', anchor.dataset.anchorIcon ?? ''), SHOWN),
    );
  };

  // The link still leads to the heading: the copy comes on top of it.
  document.addEventListener('click', async (event) => {
    const anchor =
      event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-heading-anchor]')
        : null;
    if (!anchor || !navigator.clipboard) return;
    const url = new URL(anchor.getAttribute('href') ?? '', location.href).href;
    let copied = true;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      copied = false;
    }
    announce(copied);
    if (copied) showCopied(anchor);
  });
</script>
