---
// The levels of adoption of Magma on the home page: Level cards in order, side
// by side when the content column has room, one below the other otherwise.
// Each level takes two rows, its card and its caption (Level.astro).
---

<div class="@container">
  <ol class="grid gap-600 @2xl:grid-cols-2 @4xl:grid-cols-3 @6xl:grid-cols-4 px-0">
    <slot />
  </ol>
</div>
