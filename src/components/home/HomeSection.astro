---
// A band of the home page: a centered heading with its lead, then the slot,
// then, when given, a button to the page that tells more (`href`, labelled
// `action`, relative to the page; `external` opens it in a new tab). The
// `before` slot goes above the heading, in its column (the mascot of the
// agents band), `badge` right above the heading (what is new). With an `aside`
// slot, the heading and the lead sit on its left, aligned to the start, once
// the band is wide enough for both (centered above it before), and the button
// goes under the lead. `not-content`: the band sets its own space, Starlight
// would add 1rem.
interface Props {
  /** Id of the heading, for links to the band. */
  id: string;
  title: string;
  lead?: string;
  href?: string;
  action?: string;
  /** The page of `href` is another site: a new tab. */
  external?: boolean;
  /** A word above the heading, as mds-badge: what is new. */
  badge?: string;
}

const { id, title, lead, href, action, external = false, badge } = Astro.props;
const aside = Astro.slots.has('aside');
const button = href && {
  href,
  type: 'a',
  target: external ? 'blank' : undefined,
  label: action,
  icon: external ? 'mi/baseline/open-in-new' : 'mi/baseline/arrow-forward',
  'icon-position': 'right',
  variant: 'primary',
  tone: 'weak',
  size: 'lg',
};
---

<section class:list={['not-content mt-2400', aside && '@container']} aria-labelledby={id}>
  <div
    class:list={[
      aside && 'mb-1000 grid items-center gap-1000 @5xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]',
    ]}
  >
    <div
      class:list={[
        'flex flex-col gap-300',
        aside
          ? 'mx-auto max-w-3xl items-center text-center @5xl:mx-0 @5xl:items-start @5xl:text-start'
          : 'mx-auto mb-1000 max-w-3xl items-center text-center',
      ]}
    >
      <slot name="before" />
      {badge && <mds-badge label={badge} variant="blue" tone="strong" />}
      <mds-text id={id} typography="h2" tag="h2" class="block scroll-mt-600">
        {title}
      </mds-text>
      {lead && (
        <mds-text typography="paragraph" variant="read" tag="p" class="block text-fg-muted">
          {lead}
        </mds-text>
      )}
      {aside && button && <mds-button class="mt-400 self-center @5xl:self-start" {...button} />}
    </div>
    <slot name="aside" />
  </div>
  <slot />
  {!aside && button && (
    <div class="mt-800 flex justify-center">
      <mds-button {...button} />
    </div>
  )}
</section>
