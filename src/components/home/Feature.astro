---
// A strength of Magma on the home page, as mds-card: the icon and the title,
// a band with its gist in two lines (`description`, all that a quick reader
// reads) and, when given, a figure that proves it (`stat`: how many of a
// total, as mds-benchmark-bar), the text that explains it and a link to the
// page that explains it. One accent paints the icon, the band, the bar and the
// button: `primary`, or `ai` for what is about AI. Inside Features.astro.

interface Props {
  /** An mds-icon slug, collected by iconsauce from the page that uses it. */
  icon: string;
  /** The accent: a variant that mds-button and mds-benchmark-bar both take. */
  variant?: 'primary' | 'ai';
  title: string;
  /** The gist in about two lines, under the title. */
  description: string;
  text: string;
  /** What it counts (`label`), and how many (`value`) of how many (`total`). */
  stat?: { value: number; total: number; label: string };
  href?: string;
  action?: string;
}

const { icon, variant = 'primary', title, description, text, stat, href, action } = Astro.props;

// The accent roles of each variant, as whole class names for Tailwind.
const ACCENT = {
  primary: { icon: 'text-accent-fg', band: 'bg-accent-surface-subtle text-accent-fg' },
  ai: { icon: 'text-accent-ai-fg', band: 'bg-accent-ai-surface-subtle text-accent-ai-fg' },
};
const accent = ACCENT[variant];

// The bar fills to MAX_FILL at most: a few missing items out of hundreds
// would be a sliver nobody sees, and the alias still gives the exact count.
const MAX_FILL = 95;
const fill = stat && Math.min((stat.value / stat.total) * 100, MAX_FILL);
---

<mds-card class="h-full bg-surface-overlay">
  <mds-card-header class="items-start justify-start p-600 bg-surface-overlay">
    <mds-icon name={icon} class:list={['w-1200 shrink-0', accent.icon]}></mds-icon>
    <mds-text typography="h4" tag="h3" class="w-full">
      {title}
    </mds-text>
  </mds-card-header>
  <mds-card-content class="flex grow flex-col gap-600 pt-0 p-600 bg-surface-overlay">
    <div class:list={['flex flex-col gap-400 p-400 -mx-200 rounded-lg', accent.band]}>
      <mds-text typography="caption" tag="p">
        {description}
      </mds-text>
      {stat && (
        <div class="p-400 rounded-md -mx-200 -mb-200 bg-surface-overlay shadow-sm">
          <mds-benchmark-bar
            label={stat.label}
            value={fill}
            alias={`${stat.value} / ${stat.total}`}
            variant={variant}
          />
        </div>
      )}
    </div>
    <mds-text typography="detail" tag="p" class="block">
      {text}
    </mds-text>
  </mds-card-content>
  {href && (
    <mds-card-footer class="bg-surface-overlay p-600">
      <mds-button
        href={href}
        role="link"
        type="a"
        label={action}
        aria-label={`${action}: ${title}`}
        icon="mi/baseline/arrow-forward"
        icon-position="right"
        variant={variant}
        tone="strong"
      />
    </mds-card-footer>
  )}
</mds-card>
