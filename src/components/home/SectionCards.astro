---
// The sections of the site on the home page, as cards that open them: the
// icon of the section (src/lib/nav.mjs) in a label color of its own, its
// name, and the description of its landing page in the language of the page
// (the components landing is generated: its description is a UI string),
// with a badge under the name of the sections still being written (`soon`).
// The home section itself is left out; Storybook closes the grid, opening in
// a new tab.
import type { ThemeFullVariantAvatarType } from '@maggioli-design-system/magma';
import { getEntry } from 'astro:content';
import { localePrefix } from '../../lib/frame';
import { STORYBOOK, sections } from '../../lib/nav.mjs';

/** The label color of each section. */
const VARIANTS: Record<string, ThemeFullVariantAvatarType> = {
  foundation: 'amaranth',
  tokens: 'violet',
  icons: 'orange',
  components: 'blue',
  blocks: 'lime',
  patterns: 'aqua',
  brand: 'green',
  development: 'sky',
  ai: 'purple',
  community: 'yellow',
};

const { t, starlightRoute } = Astro.locals;
const { locale } = starlightRoute;

const pages = await Promise.all(
  sections
    .filter(({ id }) => id !== 'home')
    .map(async ({ id, icon, soon }) => {
      const entry =
        id === 'components'
          ? undefined
          : ((locale ? await getEntry('docs', `${locale}/${id}`) : undefined) ??
            (await getEntry('docs', id)));
      return {
        icon,
        variant: VARIANTS[id],
        title: t(`nav.${id}` as never),
        description: entry?.data.description ?? t('components.description'),
        href: `${localePrefix(locale)}/${id}/`,
        external: false,
        soon: soon ?? false,
      };
    }),
);

const cards = [
  ...pages,
  {
    icon: 'mi/baseline/auto-stories',
    variant: 'orchid' as const,
    title: t('frame.storybook'),
    description: t('home.storybook.description'),
    href: STORYBOOK,
    external: true,
    soon: false,
  },
];
---

<div class="not-content @container">
  <div class="grid gap-600 @2xl:grid-cols-2 @4xl:grid-cols-3 @6xl:grid-cols-4">
    {cards.map(({ icon, variant, title, description, href, external, soon }) => {
      const action = external ? t('home.storybook.open') : t('cards.open');
      return (
        <mds-card class="bg-surface-overlay">
          <mds-card-header class="items-start bg-surface-overlay">
            <mds-entity
              icon={icon}
              variant={variant}
              tone="weak"
              class="shadow-none p-0 bg-transparent w-full"
            >
              <mds-text typography="h6" tag="h3">
                {title}
              </mds-text>
              {soon && (
                <mds-badge slot="detail" variant="info" tone="weak" label={t('soon.title')} />
              )}
            </mds-entity>
          </mds-card-header>
          <mds-card-content class="grow pt-0 bg-surface-overlay">
            <mds-text typography="detail">{description}</mds-text>
          </mds-card-content>
          <mds-card-footer class="bg-surface-overlay">
            <mds-button
              href={href}
              role="link"
              type="a"
              target={external ? 'blank' : undefined}
              label={action}
              aria-label={`${action}: ${title}`}
              icon={external ? 'mi/baseline/open-in-new' : 'mi/baseline/arrow-forward'}
              icon-position="right"
              variant="primary"
              tone="text"
            />
          </mds-card-footer>
        </mds-card>
      );
    })}
  </div>
</div>
