---
// Previews of the pages of a section, for its landing page: one mds-card per
// page, with an icon, the title and the description of the page (from its
// frontmatter, in the language of the current page, else in English) and a
// button that opens it. Two columns when the content column has room. A
// domain of the design language, a page generated from the installed magma,
// is named in the language of the page and described by its need, in English.
import { getEntry } from 'astro:content';
import { domainHref } from '../lib/domains';
import { localePrefix } from '../lib/frame';

interface Props {
  /**
   * `slug` of the page without the locale, or `domain`, the id of a domain of
   * the design language; `icon` is an mds-icon slug, collected by iconsauce.
   */
  pages: ({ slug: string; icon: string } | { domain: string; icon: string })[];
}

const { pages } = Astro.props;
const { t, starlightRoute } = Astro.locals;
const { locale } = starlightRoute;

const cards = await Promise.all(
  pages.map(async (page) => {
    const { icon } = page;
    if ('domain' in page) {
      const domain = await getEntry('domains', page.domain);
      if (!domain) throw new Error(`PageCards: no domain ${page.domain}`);
      return {
        icon,
        title: t(`nav.foundation.${page.domain}` as any),
        description: domain.data.need,
        descriptionLang: locale ? 'en' : undefined,
        href: domainHref(locale, page.domain),
      };
    }
    const { slug } = page;
    const entry =
      (locale ? await getEntry('docs', `${locale}/${slug}`) : undefined) ??
      (await getEntry('docs', slug));
    if (!entry) throw new Error(`PageCards: no page ${slug}`);
    return {
      icon,
      title: entry.data.title,
      description: entry.data.description,
      descriptionLang: undefined,
      href: `${localePrefix(locale)}/${slug}/`,
    };
  }),
);
---

{/* `not-content`: Starlight would put 1rem above every card but the first. */}
<div class="not-content @container my-600">
  <div class="grid gap-600 @xl:grid-cols-2">
    {cards.map(({ icon, title, description, descriptionLang, href }) => (
      <mds-card class="bg-surface-overlay">
        <mds-card-header class="items-start bg-surface-overlay">
          <mds-entity
            icon={icon}
            variant="primary"
            tone="weak"
            class="shadow-none p-0 bg-transparent w-full"
          >
            <mds-text typography="h6" tag="h3">
              {title}
            </mds-text>
          </mds-entity>
        </mds-card-header>
        <mds-card-content class="pt-0 bg-surface-overlay">
          <mds-text typography="detail" lang={descriptionLang}>
            {description}
          </mds-text>
        </mds-card-content>
        <mds-card-footer class="bg-surface-overlay">
          <mds-button
            href={href}
            type="a"
            label={t('cards.open')}
            aria-label={`${t('cards.open')}: ${title}`}
            icon="mi/baseline/arrow-forward"
            icon-position="right"
            variant="primary"
            tone="text"
          />
        </mds-card-footer>
      </mds-card>
    ))}
  </div>
</div>
