---
// The preview at the top of a component's overview: its first Pattern
// example running in an iframe (src/pages/example/[tag].astro), away from the styles of the site,
// on a stage where a handle at its right narrows it, to see the component in
// less room (as in the layout mockups), and a handle under it makes it shorter
// or taller than the example, to see what depends on the height of the
// viewport (overlays that open where there is room, what is fixed to the
// viewport or follows its scroll); then a control for each prop that
// takes a value to type or pick, in a grid of compact fields: the control,
// the prop's name, its kind and its description in an mds-help; a text or
// number field shows, while empty, an example of what the prop takes, when
// documentation.json has one (src/lib/controls.ts). Icon props
// (`icon`, `iconChecked`) pick from the icons Magma's usage docs use most and
// the ones of the example, or none. A control
// sets the prop on the element of the example; when the component changes a
// prop itself (an accordion item opened by a click), its control follows.
// Then a button for each method whose parameters take a value to type or
// pick, with a field for each of them: it calls the method on the element of
// the example, and a line under the buttons says what the call gave back. Some
// components are all in their methods (mds-emoji). Reset loads the example
// again at full width and at its own height. The buttons of the methods wait,
// disabled, until the preview is ready; a control changed before is let go,
// and shows the value of its prop once it is. A pattern
// (src/components/PatternPreview.astro) runs its own page on the same stage,
// with its own texts and without controls; the buttons of the `actions` slot
// go next to Reset.
import { methodCalls, plainText, propControl, propExample, type Control } from '../lib/controls';
import { ICON_SLUG, usageIcons } from '../lib/magma.mjs';
import { READING, TEXT } from '../lib/markdown-text.mjs';
import Code from './Code.astro';
import Heading from './Heading.astro';
import PlaygroundField from './PlaygroundField.astro';

interface Props {
  tag: string;
  props: any[];
  /** The methods of the component, as documentation.json lists them. */
  methods?: any[];
  /** The markup the preview runs. */
  example: string;
  /** The page the preview runs, when it is not the component's example. */
  src?: string;
  /** The text above the stage, when it is not the component's one. */
  intro?: string;
  /** The title of the frame, when it is not the component's one. */
  title?: string;
}

const { tag, props, methods = [], example, intro, title } = Astro.props;
const { t } = Astro.locals;
const src = Astro.props.src ?? `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}example/${tag}/`;

// Grouped by kind, so the switches share their rows and the fields theirs;
// by name within a group. Props with no control (functions, arrays, files)
// are left to the API page.
const ORDER: Control['kind'][] = ['enum', 'boolean', 'string', 'number'];
// A prop that takes an icon slug, which iconsauce has to know beforehand: a
// select of icons it collects (it reads documentation.json) instead of a field.
const ICON_PROP = /^icon(?:[A-Z]|$)/;
const icons = [...new Set([...example.matchAll(ICON_SLUG)].map(([slug]) => slug))]
  .concat(usageIcons(20))
  .filter((slug, i, all) => all.indexOf(slug) === i)
  .sort();
const fields = props
  .flatMap((prop) => {
    const control = propControl(prop);
    if (!control) return [];
    const name = prop.name as string;
    const icon = control.kind === 'string' && ICON_PROP.test(name);
    return [{ name, docs: plainText(prop.docs), control, icon, example: propExample(prop) }];
  })
  .sort(
    (a, b) =>
      ORDER.indexOf(a.control.kind) - ORDER.indexOf(b.control.kind) || a.name.localeCompare(b.name),
  );
const calls = methodCalls(methods);
/** What a text or number field shows while empty: an example of its value. */
const placeholder = (value: string | undefined) =>
  value &&
  // Astro escapes the attribute: i18next does not need to.
  t('component.preview.example', { value, interpolation: { escapeValue: false } });
---

<mds-text {...READING} tag="p" class={TEXT.paragraph}>
  {intro ?? t('component.preview.intro')}
  {fields.length > 0 && ` ${t('component.preview.controls')}`}
</mds-text>
{/*
  The stage, sunken, and on it the frame, raised, as wide as the stage and as
  tall as the example until a handle is dragged or moved with the arrow keys:
  the one at its right sets the width, the one under it the height (window
  splitters: focusable separators with their value). Magma has no resize
  handle.
*/}
<div class="flex rounded-3xl bg-surface-sunken p-400">
  <div
    class="grid w-full max-w-full grid-cols-[minmax(0,1fr)_auto] overflow-hidden rounded-xl bg-surface-raised shadow-sm"
    data-playground-viewport={tag}
  >
    <iframe
      src={src}
      title={
        title ??
        t('component.preview.title', {
          tag: `<${tag}>`,
          // Astro escapes the attribute: i18next does not need to.
          interpolation: { escapeValue: false },
        })
      }
      class="block h-5000 w-full min-w-0 border-0"
      data-playground-frame={tag}
    ></iframe>
    <div
      role="separator"
      aria-orientation="vertical"
      aria-label={t('component.preview.resize')}
      tabindex="0"
      class="group mt-0 flex w-600 cursor-ew-resize touch-none items-center justify-center outline-none"
      data-playground-handle={tag}
    >
      {/* Magma's focus ring on the bar, not on the strip that holds it. */}
      <span class="focus-bounce group-focus-visible:focus-bounce--focused h-1600 group-hover:h-1800 w-150 rounded-full bg-border-muted group-hover:bg-surface-inverse-muted group-focus-visible:bg-surface-inverse-muted transition-cosmetic"></span>
    </div>
    <div
      role="separator"
      aria-orientation="horizontal"
      aria-label={t('component.preview.resizeHeight')}
      tabindex="0"
      class="group mt-0 flex h-600 cursor-ns-resize touch-none items-center justify-center outline-none"
      data-playground-height-handle={tag}
    >
      <span class="focus-bounce group-focus-visible:focus-bounce--focused w-1600 group-hover:w-1800 h-150 rounded-full bg-border-muted group-hover:bg-surface-inverse-muted group-focus-visible:bg-surface-inverse-muted transition-cosmetic"></span>
    </div>
  </div>
</div>
<div class="flex justify-end gap-200">
  <slot name="actions" />
  <mds-button
    label={t('component.preview.reset')}
    icon="mi/baseline/refresh"
    variant="dark"
    tone="text"
    size="sm"
    type="button"
    data-playground-reset={tag}
  ></mds-button>
</div>

{fields.length > 0 && (
  <>
    <Heading id="props" typography="h3" text={t('component.props')} />
    {/*
      As many columns of at least 13rem as the page has room for: 3 on
      desktop, 1 on phones. `not-content`: Starlight would put 1rem above
      each element that follows another, the kind after the name included.
    */}
    <div
      class="not-content grid grid-cols-[repeat(auto-fill,minmax(--spacing(5200),1fr))] items-end gap-800"
      data-playground-controls={tag}
    >
      {fields.map(({ name, docs, control, icon, example }) => (
        <PlaygroundField
          name={name}
          docs={docs}
          control={control}
          placeholder={placeholder(example)}
          icons={icon ? icons : undefined}
          hook="data-prop"
        />
      ))}
    </div>
  </>
)}

{calls.length > 0 && (
  <>
    <Heading id="methods" typography="h3" text={t('component.methods')} />
    <mds-text {...READING} tag="p" class={TEXT.paragraph}>
      {t('component.preview.methods')}
    </mds-text>
    {/* Shown while the system asks for reduced motion (script below). */}
    <mds-text {...READING} tag="p" class:list={[TEXT.paragraph, 'hidden']} data-playground-motion>
      {t('component.preview.motion')}
    </mds-text>
    {/*
      The grid of the props, at the top of its cells: each method, a play
      button and its name in code (mds-button capitalizes the first letter
      of a label), then the fields of its parameters.
    */}
    <div
      class="not-content grid grid-cols-[repeat(auto-fill,minmax(--spacing(5200),1fr))] items-start gap-800"
      data-playground-methods={tag}
    >
      {calls.map((call) => (
        <div class="flex min-w-0 flex-col gap-400" data-method={call.name}>
          <span class="flex min-w-0 items-center gap-200">
            <mds-button
              icon="mi/baseline/play-arrow"
              aria-label={t('component.preview.call', {
                method: call.name,
                // Astro escapes the attribute: i18next does not need to.
                interpolation: { escapeValue: false },
              })}
              variant="primary"
              tone="weak"
              size="sm"
              type="button"
              disabled
              data-call={call.name}
            ></mds-button>
            <Code name>{call.name}</Code>
            {call.docs && <mds-help>{call.docs}</mds-help>}
          </span>
          {call.parameters.map((parameter) => (
            <PlaygroundField
              name={parameter.name}
              docs={parameter.docs}
              control={parameter.control}
              placeholder={placeholder(parameter.example)}
              hook="data-param"
            />
          ))}
        </div>
      ))}
    </div>
    {/*
      What the last call gave back, announced. The words come from the
      dictionaries, the call and its value are code (the template).
    */}
    <mds-text
      typography="detail"
      tag="p"
      role="status"
      class="not-content text-fg-muted"
      data-playground-result={tag}
      data-idle={t('component.preview.idle')}
      data-running={t('component.preview.running')}
      data-done={t('component.preview.done')}
      data-returned={t('component.preview.returned')}
      data-failed={t('component.preview.failed')}
    >
      {t('component.preview.idle')}
    </mds-text>
    <template data-playground-code={tag}>
      <Code>-</Code>
    </template>
  </>
)}

<script>
  type Kind = 'boolean' | 'enum' | 'string' | 'number';
  type MagmaElement = HTMLElement & { componentOnReady?(): Promise<unknown> };
  /** A Magma field of the grid, by the props it is set through. */
  type Field = HTMLElement & { checked?: boolean; value?: unknown; disabled?: boolean };

  interface Playground {
    tag: string;
    frame: HTMLIFrameElement;
    controls: HTMLElement | null;
    /** The buttons of the methods and the fields of their parameters. */
    methods: HTMLElement | null;
    /** The line that says what the last call gave back. */
    result: HTMLElement | null;
    /** The element of the example the controls set, once the preview is ready. */
    element?: HTMLElement;
    /** What each control shows: the value its prop had last. */
    shown: Map<string, unknown>;
    /** Counts the loads of the preview: a newer one stops the setup of an older one. */
    load: number;
    /** The height set with the handle, in px; `undefined`: as tall as the example. */
    height?: number;
    /** Counts the calls of methods: only the last one reports how it went. */
    calls: number;
    stop?: () => void;
  }

  const playgrounds = new WeakMap<HTMLIFrameElement, Playground>();
  /** Not a value: a number field holding something else than a number. */
  const INVALID = Symbol('invalid');
  const MODE = /^pref-mode-/;

  const fields = (playground: Playground) => [
    ...(playground.controls?.querySelectorAll<Field>('[data-prop]') ?? []),
  ];

  const prop = (element: HTMLElement, name: string) =>
    (element as unknown as Record<string, unknown>)[name];

  /** What a control's value sets its prop to. */
  const fromField = (kind: Kind, optional: boolean, value: unknown): unknown => {
    if (kind === 'boolean') return Boolean(value);
    if (value === '' || value === null || value === undefined) {
      if (kind === 'string' && !optional) return '';
      return optional || kind === 'enum' ? undefined : INVALID;
    }
    if (kind === 'number') {
      const number = Number(value);
      return Number.isNaN(number) ? INVALID : number;
    }
    return String(value);
  };

  const showValue = (field: Field, kind: Kind, value: unknown) => {
    if (kind === 'boolean') {
      field.checked = Boolean(value);
      return;
    }
    const text = value === undefined || value === null ? '' : String(value);
    // A value the select has no option for, as an icon the component sets
    // itself: it gets one, so the select can show it.
    if (
      text &&
      field.localName === 'mds-input-select' &&
      ![...field.querySelectorAll('option')].some((option) => option.value === text)
    ) {
      field.append(new Option(text, text));
    }
    field.value = text;
  };

  /** Every control on the value its prop has now. */
  const show = (playground: Playground) => {
    const { element } = playground;
    if (!element) return;
    for (const field of fields(playground)) {
      const name = field.dataset.prop!;
      const value = prop(element, name);
      if (playground.shown.has(name) && Object.is(playground.shown.get(name), value)) continue;
      playground.shown.set(name, value);
      showValue(field, field.dataset.kind as Kind, value);
    }
  };

  /** The buttons of the methods. */
  const callers = (playground: Playground) => [
    ...(playground.methods?.querySelectorAll<Field>('[data-call]') ?? []),
  ];

  // Only the buttons: the controls stay enabled, a change made before the
  // preview is ready is let go.
  const enable = (playground: Playground, enabled: boolean) => {
    for (const button of callers(playground)) button.disabled = !enabled;
  };

  /** The longest a value is shown, in characters. */
  const MAX_VALUE = 300;

  /**
   * What a call gave back, as short text: elements by their tag, files by
   * their name, lists of files as arrays, the rest as JSON. The values come
   * from the window of the preview, where `instanceof` does not see the
   * classes of this one.
   */
  const describe = (value: unknown) => {
    const plain = (item: unknown, depth: number): unknown => {
      if (typeof item !== 'object' || item === null) return item;
      if (depth > 3) return '...';
      const node = item as { nodeType?: number; localName?: string };
      if (node.nodeType === 1) return `<${node.localName}>`;
      const file = item as { name?: unknown; lastModified?: unknown };
      if (typeof file.name === 'string' && typeof file.lastModified === 'number') {
        return `File ${file.name}`;
      }
      const list = item as { length?: unknown; item?: unknown };
      if (
        Array.isArray(item) ||
        (typeof list.length === 'number' && typeof list.item === 'function')
      ) {
        return Array.from(item as ArrayLike<unknown>, (member) => plain(member, depth + 1));
      }
      return Object.fromEntries(
        Object.entries(item).map(([key, member]) => [key, plain(member, depth + 1)]),
      );
    };
    const shown = plain(value, 0);
    // An element or a file as it is, not as a JSON string in quotes.
    const text =
      typeof shown === 'string' && shown !== value
        ? shown
        : (JSON.stringify(shown) ?? String(value));
    return text.length > MAX_VALUE ? `${text.slice(0, MAX_VALUE - 3)}...` : text;
  };

  /**
   * The line under the buttons: the call, what happened to it
   * (`data-running`, `data-done`, `data-returned`, `data-failed`) and the
   * value, if any. Without a call, the text it has while nothing was called.
   */
  const report = (
    playground: Playground,
    outcome?: { call: string; word: 'running' | 'done' | 'returned' | 'failed'; value?: string },
  ) => {
    const { result, tag } = playground;
    if (!result) return;
    if (!outcome) {
      result.textContent = result.dataset.idle ?? '';
      return;
    }
    const template = document.querySelector<HTMLTemplateElement>(`[data-playground-code="${tag}"]`);
    const code = (text: string) => {
      const element = template?.content.firstElementChild?.cloneNode(true) as
        HTMLElement | undefined;
      if (!element) return text;
      element.textContent = text;
      return element;
    };
    const parts: (string | Node)[] = [code(outcome.call), ` ${result.dataset[outcome.word] ?? ''}`];
    if (outcome.value !== undefined) parts.push(' ', code(outcome.value));
    result.replaceChildren(...parts);
  };

  /** A method's button was pressed: the call, with the values of its fields. */
  const call = async (playground: Playground, button: HTMLElement) => {
    const { element } = playground;
    const name = button.dataset.call;
    if (!element || !name) return;
    const args = [
      ...(button.closest('[data-method]')?.querySelectorAll<Field>('[data-param]') ?? []),
    ].map((field) => {
      const kind = field.dataset.kind as Kind;
      const value = fromField(
        kind,
        field.dataset.optional === 'true',
        kind === 'boolean' ? field.checked : field.value,
      );
      return value === INVALID ? undefined : value;
    });
    // The optional parameters left empty at the end stay out of the call.
    while (args.length > 0 && args[args.length - 1] === undefined) args.pop();
    const shown = `${name}(${args.map((arg) => JSON.stringify(arg) ?? 'undefined').join(', ')})`;
    // Methods that animate resolve when the animation ends, seconds later:
    // the line says the call is running, and a newer call, or a new load of
    // the preview, takes its place.
    const count = ++playground.calls;
    const load = playground.load;
    const last = () => count === playground.calls && load === playground.load;
    report(playground, { call: shown, word: 'running' });
    try {
      const method = prop(element, name) as (...args: unknown[]) => unknown;
      const value = await method.apply(element, args);
      if (!last()) return;
      report(
        playground,
        value === undefined
          ? { call: shown, word: 'done' }
          : { call: shown, word: 'returned', value: describe(value) },
      );
    } catch (error) {
      if (!last()) return;
      const message = (error as { message?: unknown } | null)?.message;
      report(playground, {
        call: shown,
        word: 'failed',
        value: typeof message === 'string' ? message : String(error),
      });
    }
  };

  /** A control changed: its prop takes the new value. */
  const change = (playground: Playground, event: Event) => {
    const field =
      event.target instanceof Element ? event.target.closest<Field>('[data-prop]') : null;
    const { element } = playground;
    if (!field || !element) return;
    const name = field.dataset.prop!;
    const kind = field.dataset.kind as Kind;
    const detail = (event as CustomEvent<{ checked?: boolean; value?: unknown }>).detail ?? {};
    const value = fromField(
      kind,
      field.dataset.optional === 'true',
      kind === 'boolean' ? detail.checked : detail.value,
    );
    // Also the echo of a control the preview has just set.
    if (value === INVALID || Object.is(value, prop(element, name))) return;
    playground.shown.set(name, value);
    (element as unknown as Record<string, unknown>)[name] = value;
  };

  /** The light or dark mode and the theme of the page, in the preview too. */
  const syncMode = (doc: Document) => {
    const root = doc.documentElement;
    root.classList.remove(...[...root.classList].filter((name) => MODE.test(name)));
    root.classList.add(
      ...[...document.documentElement.classList].filter((name) => MODE.test(name)),
    );
    // Without data-magma-pref Magma follows the system's mode, whatever the class.
    for (const name of ['data-magma-pref', 'data-theme-name']) {
      const value = document.documentElement.getAttribute(name);
      if (value === null) root.removeAttribute(name);
      else root.setAttribute(name, value);
    }
  };

  /** A load of the preview: its height, its mode, then the controls on its element. */
  const connect = async (playground: Playground) => {
    playground.stop?.();
    playground.stop = undefined;
    playground.element = undefined;
    playground.shown.clear();
    enable(playground, false);
    const load = ++playground.load;
    const { frame, tag } = playground;
    // `null` once a link of the example led to another site.
    const doc = frame.contentDocument;
    const win = frame.contentWindow as (Window & typeof globalThis) | null;
    if (!doc || !win || !doc.body?.hasAttribute('data-preview')) return;

    // As tall as the example, now and when it changes, unless the handle set
    // a height; the observers of the preview's own window.
    const fit = () => {
      if (playground.height !== undefined) return;
      frame.style.height = `${Math.ceil(doc.body.getBoundingClientRect().height)}px`;
    };
    fit();
    const resize = new win.ResizeObserver(fit);
    resize.observe(doc.body);
    const mode = new MutationObserver(() => syncMode(doc));
    mode.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class', 'data-theme-name'],
    });
    syncMode(doc);
    let changes: MutationObserver | undefined;
    playground.stop = () => {
      resize.disconnect();
      mode.disconnect();
      changes?.disconnect();
    };

    report(playground);
    // No controls and no methods (a pattern): nothing to set on an element.
    if (!playground.controls && !playground.methods) return;
    const element = doc.querySelector<MagmaElement>(tag);
    if (!element) return;
    await win.customElements.whenDefined(tag);
    await element.componentOnReady?.();
    if (load !== playground.load) return;
    playground.element = element;
    show(playground);
    // Props the component changes itself, as far as they show in its attributes.
    changes = new win.MutationObserver(() => show(playground));
    changes.observe(element, { attributes: true });
    enable(playground, true);
  };

  /** The narrowest the example gets, in pixels: a small phone. */
  const MIN_WIDTH = 320;
  /** The shortest the example gets, in pixels: a strip of it. */
  const MIN_HEIGHT = 120;
  /** How far an arrow key moves a handle, with Shift for a longer step. */
  const STEP = 16;
  const LONG_STEP = 80;

  /** One size of the frame, its width or its height, and the handle that sets it. */
  interface Axis {
    handle: HTMLElement;
    /** Where the pointer is along the axis. */
    position: (event: PointerEvent) => number;
    /** The keys that make the frame smaller and bigger. */
    smaller: string;
    bigger: string;
    current: () => number;
    limits: () => { min: number; max: number };
    /** The frame this big, within the limits; `undefined`: as it is by default. */
    set: (size: number | undefined) => void;
  }

  /**
   * A handle of the frame: dragged, or moved with the arrow keys, Home and
   * End, it sets one size of the example. Returns what writes its value, and
   * what sets the size.
   */
  const resizeHandle = (frame: HTMLIFrameElement, axis: Axis) => {
    const { handle, current, limits } = axis;
    /** The separator's value: the size of the example. */
    const update = () => {
      const { min, max } = limits();
      handle.setAttribute('aria-valuemin', String(Math.round(min)));
      handle.setAttribute('aria-valuemax', String(Math.round(max)));
      handle.setAttribute('aria-valuenow', String(current()));
      handle.setAttribute('aria-valuetext', `${current()} px`);
    };
    const set = (size: number | undefined) => {
      axis.set(size);
      update();
    };

    /** Ends the drag in progress, if there is one. */
    let endDrag: (() => void) | undefined;

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      event.preventDefault();
      endDrag?.();
      // The moves over the frame would go to the example's page.
      frame.style.pointerEvents = 'none';
      // Where on the handle it was taken, so it does not jump.
      const offset = axis.position(event) - current();
      const drag = new AbortController();
      const { signal } = drag;
      const end = () => {
        drag.abort();
        endDrag = undefined;
        frame.style.removeProperty('pointer-events');
        if (handle.hasPointerCapture(event.pointerId))
          handle.releasePointerCapture(event.pointerId);
      };
      endDrag = end;
      const ours = (other: PointerEvent) => other.pointerId === event.pointerId;
      // Read on the window: a release outside the page, or outside the
      // browser, does not always reach the handle, even with the pointer
      // captured. A move with the button up means it went missing: the drag
      // ends there instead of following the pointer back in.
      addEventListener(
        'pointermove',
        (moved) => {
          if (!ours(moved)) return;
          if ((moved.buttons & 1) === 0) end();
          else set(axis.position(moved) - offset);
        },
        { signal },
      );
      for (const type of ['pointerup', 'pointercancel'] as const) {
        addEventListener(type, (released) => ours(released) && end(), { signal });
      }
      handle.addEventListener('lostpointercapture', end, { signal });
      // Another window or app took over in the middle of it.
      addEventListener('blur', end, { signal });
      handle.setPointerCapture(event.pointerId);
    });
    handle.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? LONG_STEP : STEP;
      const size = {
        [axis.smaller]: current() - step,
        [axis.bigger]: current() + step,
        Home: limits().min,
        End: limits().max,
      }[event.key];
      if (size === undefined) return;
      event.preventDefault();
      set(size);
    });
    return { update, set };
  };

  /**
   * The two handles of the frame: the one at its right sets how wide the
   * example is, up to the whole stage; the one under it how tall, from a
   * strip of it to the height of the example or of the window, whichever is
   * more. Returns what gives the example the whole stage and its own height
   * again.
   */
  const resizable = (playground: Playground) => {
    const { frame, tag } = playground;
    const viewport = document.querySelector<HTMLElement>(`[data-playground-viewport="${tag}"]`);
    const widthHandle = document.querySelector<HTMLElement>(`[data-playground-handle="${tag}"]`);
    const heightHandle = document.querySelector<HTMLElement>(
      `[data-playground-height-handle="${tag}"]`,
    );
    const stage = viewport?.parentElement;
    if (!viewport || !widthHandle || !heightHandle || !stage) return () => {};

    /** How wide the example can be: the stage without its padding and the handle. */
    const widthLimits = () => {
      const style = getComputedStyle(stage);
      const max =
        stage.clientWidth -
        parseFloat(style.paddingLeft) -
        parseFloat(style.paddingRight) -
        widthHandle.offsetWidth;
      return { min: Math.min(MIN_WIDTH, max), max };
    };
    const width = resizeHandle(frame, {
      handle: widthHandle,
      position: (event) => event.clientX,
      smaller: 'ArrowLeft',
      bigger: 'ArrowRight',
      current: () => Math.round(frame.getBoundingClientRect().width),
      limits: widthLimits,
      // The whole stage when `undefined` or wider.
      set: (size) => {
        const { min, max } = widthLimits();
        if (size === undefined || size >= max) viewport.style.removeProperty('width');
        else viewport.style.width = `${Math.max(min, size) + widthHandle.offsetWidth}px`;
      },
    });

    /** How tall the example is on its page: its body, which the frame does not stretch. */
    const exampleHeight = () =>
      Math.ceil(frame.contentDocument?.body?.getBoundingClientRect().height ?? 0);
    const heightLimits = () => ({
      min: MIN_HEIGHT,
      max: Math.max(MIN_HEIGHT, exampleHeight(), innerHeight),
    });
    const height = resizeHandle(frame, {
      handle: heightHandle,
      position: (event) => event.clientY,
      smaller: 'ArrowUp',
      bigger: 'ArrowDown',
      current: () => Math.round(frame.getBoundingClientRect().height),
      limits: heightLimits,
      // `undefined`: as tall as the example again, from its next load.
      set: (size) => {
        if (size === undefined) {
          playground.height = undefined;
          return;
        }
        const { min, max } = heightLimits();
        playground.height = Math.round(Math.min(max, Math.max(min, size)));
        frame.style.height = `${playground.height}px`;
      },
    });

    // The page gets narrower or wider, and the example taller or shorter: the
    // room the handles have, and their values, follow.
    const update = () => {
      width.update();
      height.update();
    };
    const sizes = new ResizeObserver(update);
    sizes.observe(stage);
    sizes.observe(frame);
    update();
    return () => {
      width.set(undefined);
      height.set(undefined);
    };
  };

  /**
   * The note over the methods while the system asks for reduced motion: the
   * preview follows the system there, and some components keep their
   * animations still (mds-emoji its blinking and the pointer).
   */
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const showMotion = () => {
    for (const note of document.querySelectorAll('[data-playground-motion]')) {
      note.classList.toggle('hidden', !motion.matches);
    }
  };
  motion.addEventListener('change', showMotion);

  /** The playgrounds of the page, again on every page of the router. */
  const init = () => {
    showMotion();
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-playground-frame]')) {
      if (playgrounds.has(frame)) continue;
      const tag = frame.dataset.playgroundFrame!;
      const playground: Playground = {
        tag,
        frame,
        controls: document.querySelector(`[data-playground-controls="${tag}"]`),
        methods: document.querySelector(`[data-playground-methods="${tag}"]`),
        result: document.querySelector(`[data-playground-result="${tag}"]`),
        shown: new Map(),
        load: 0,
        calls: 0,
      };
      playgrounds.set(frame, playground);

      for (const type of ['mdsInputSwitchChange', 'mdsInputSelectChange', 'mdsInputChange']) {
        playground.controls?.addEventListener(type, (event) => change(playground, event));
      }
      playground.methods?.addEventListener('click', (event) => {
        const button =
          event.target instanceof Element ? event.target.closest<Field>('[data-call]') : null;
        if (button && !button.disabled) call(playground, button);
      });
      const fullSize = resizable(playground);
      document.querySelector(`[data-playground-reset="${tag}"]`)?.addEventListener('click', () => {
        fullSize();
        // Setting `src` loads it again, wherever the example led the frame.
        frame.src = frame.getAttribute('src') ?? '';
      });
      frame.addEventListener('load', () => connect(playground));
      // Already loaded before this script ran.
      if (frame.contentDocument?.readyState === 'complete') connect(playground);
    }
  };

  // The frame goes with the page it is on.
  document.addEventListener('astro:before-swap', () => {
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-playground-frame]')) {
      playgrounds.get(frame)?.stop?.();
    }
  });
  document.addEventListener('astro:page-load', init);
  init();
</script>
