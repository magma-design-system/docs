---
// Repository and Storybook links, light/dark mode, theme and language: at the
// bottom of the rail and in the mobile menu (the search is at their top,
// SearchField.astro). Mode, theme and language are Magma's own preference
// components, in the panel that groups them (mds-pref); src/scripts/magma.ts
// makes Starlight follow the mode.
//
// Rendered once, in the rail, and moved into the menu below Magma's `desktop`
// breakpoint: one set of controls for both. (Up to magma 2.0.1 a second
// mds-pref-mode also undid the choice made in the first one, magma#789.) In
// the rail the panel opens in a dropdown (Rail.astro), from the Preferences
// button here or from its icon in the collapsed rail; in the menu it is shown
// as it is, below the links.
import { locales } from '../../lib/i18n.mjs';
import { REPOSITORY, STORYBOOK } from '../../lib/nav.mjs';
import { localePrefix } from '../../lib/frame';

const { t, starlightRoute } = Astro.locals;

// The same page in every locale: the path below the locale prefix does not change.
const path = Astro.url.pathname.slice(localePrefix(starlightRoute.locale).length) || '/';
const languages = Object.entries(locales).map(([key, { lang }]) => ({
  lang,
  href: `${localePrefix(key === 'root' ? undefined : key)}${path}`,
}));

// Magma's named themes (magma/agents/theming.md): `default` is the base theme,
// the others retint the neutral roles (surfaces, wash, borders, text) with
// their family. The swatch of an item is the wash of its family; the dots on
// it (accent and status colors) are the same in every theme.
const themes = [
  { name: 'default', family: 'neutral', label: t('frame.theme.default') },
  { name: 'cool', family: 'porcelain', label: t('frame.theme.cool') },
  { name: 'warm', family: 'bisque', label: t('frame.theme.warm') },
];
---

<div class="grid grid-cols-full gap-400" id="preferences">
  <div class="flex flex-col gap-200">
    <mds-button
      href={REPOSITORY}
      target="blank"
      role="link"
      type="a"
      icon="mdi/github"
      label={t('frame.repository')}
      variant="dark"
      tone="text"
      size="sm"
    ></mds-button>
    <mds-button
      href={STORYBOOK}
      target="blank"
      role="link"
      type="a"
      icon="mi/baseline/auto-stories"
      label={t('frame.storybook')}
      variant="dark"
      tone="text"
      size="sm"
    ></mds-button>
    <mds-button
      id="preferences-trigger"
      class="in-data-[preferences=menu]:hidden"
      type="button"
      icon="mi/baseline/settings-accessibility"
      label={t('frame.preferences')}
      variant="dark"
      tone="text"
      size="sm"
    ></mds-button>
  </div>
  <div class="hidden gap-400 in-data-[preferences=menu]:grid" data-preferences="menu-panel">
    <mds-hr></mds-hr>
    <mds-pref id="preferences-panel" class="gap-400" size="sm">
      <mds-pref-language class="relative w-full" size="sm" set={starlightRoute.lang}>
        {languages.map(({ lang, href }) => (
          <mds-pref-language-item
            code={lang}
            data-href={href}
            selected={lang === starlightRoute.lang}
          />
        ))}
      </mds-pref-language>
      <mds-pref-mode class="relative w-full" size="sm"></mds-pref-mode>
      <mds-pref-theme class="relative w-full" size="sm">
        {themes.map(({ name, family, label }) => (
          <mds-pref-theme-item
            name={name}
            label={label}
            style={`--mds-pref-theme-item-color-background: rgb(var(--tone-${family}-09))`}
          />
        ))}
      </mds-pref-theme>
    </mds-pref>
  </div>
</div>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  /** Moves `element` into the one of the `data-preferences` boxes named `where`. */
  const move = (element: HTMLElement | null, where: string) => {
    const box = document.querySelector(`[data-preferences="${where}"]`);
    if (element && box && element.parentElement !== box) box.append(element);
  };

  // Magma's `desktop` breakpoint (1024px), as in the frame: rail above, menu
  // below. The panel: in the dropdown of the rail, below the links in the menu.
  const desktop = matchMedia('(min-width: 1024px)');
  const place = (where = desktop.matches ? 'rail' : 'menu') => {
    move(document.getElementById('preferences'), where);
    move(document.getElementById('preferences-panel'), desktop.matches ? 'dropdown' : 'menu-panel');
  };
  place();
  desktop.addEventListener('change', () => place());

  // Pages change in place (PageFrame.astro): the rail is kept, the menu is
  // not. Back to the rail before the change, then where the width wants them.
  // The language links lead to the new page in each language.
  document.addEventListener('astro:before-swap', (event) => {
    move(document.getElementById('preferences'), 'rail');
    const next = (event as TransitionBeforeSwapEvent).newDocument;
    document.querySelectorAll<HTMLElement>('#preferences-panel [data-href]').forEach((item) => {
      const code = item.getAttribute('code');
      const href = next.querySelector<HTMLElement>(`#preferences-panel [code="${code}"]`)?.dataset
        .href;
      if (href) item.dataset.href = href;
    });
  });
  document.addEventListener('astro:after-swap', () => place());

  // Picking a language opens the same page in that locale.
  document.addEventListener('mdsPrefLanguageChange', (event) => {
    const { language } = (event as CustomEvent<{ language: string }>).detail;
    const item = (event.target as Element).querySelector<HTMLElement>(
      `mds-pref-language-item[code="${language}"]`,
    );
    const href = item?.dataset.href;
    if (href && href !== window.location.pathname) window.location.assign(href);
  });
</script>
