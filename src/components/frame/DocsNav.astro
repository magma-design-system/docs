---
// The sub-pages column of the frame: the "Documentation" column of a component
// page, its sub-pages (src/lib/components.ts), the "Categories" column of an
// icon set page, its categories with how many icons each one has
// (src/lib/icon-pages.ts), and the "Brands" column of a Brand assets page, its
// owners with how many artworks each one has (src/lib/brand-pages.ts). A part
// of a compound component, and the component itself, add the "Parts" column:
// the parts of the component (`@parent`), which the section navigation leaves
// out.
import { getEntry } from 'astro:content';
import { componentHref, pagesOf, parseComponentPath } from '../../lib/components';
import { componentParts, componentRoot } from '../../lib/magma.mjs';
import { componentName } from '../../lib/nav.mjs';
import { brandOwnerHref, parseBrandPath } from '../../lib/brand-pages';
import { iconCategoryHref, parseIconSetPath } from '../../lib/icon-pages';

interface Props {
  /** Unique per page: the component is rendered twice (frame and mobile menu). */
  headingId: string;
}

const { headingId } = Astro.props;
const { t, starlightRoute } = Astro.locals;
const { locale } = starlightRoute;

interface Link {
  href: string;
  label: string;
  current: boolean;
}

let heading = '';
let links: Link[] = [];
let parts: Link[] = [];

const path = parseComponentPath(Astro.url.pathname, locale);
const icons = parseIconSetPath(Astro.url.pathname, locale);
const brand = parseBrandPath(Astro.url.pathname, locale);
if (path) {
  const entry = await getEntry('components', path.tag);
  heading = t('component.documentation');
  links = (entry ? pagesOf(entry.data) : []).map((page) => ({
    href: componentHref(locale, path.tag, page.slug),
    label: t(page.label),
    current: page.slug === path.slug,
  }));
  parts = componentParts(componentRoot(path.tag)).map((part) => ({
    href: componentHref(locale, part),
    label: componentName(part),
    current: part === path.tag,
  }));
} else if (icons) {
  heading = t('icons.categories');
  links = icons.categories.map(({ id, label, count }) => ({
    href: iconCategoryHref(locale, icons.set, id),
    label: `${label ?? t(`icons.set.category.${id}` as never)} (${count})`,
    current: id === icons.category,
  }));
} else if (brand) {
  heading = t('brand.owners');
  links = brand.owners.map(({ id, name, families }) => ({
    href: brandOwnerHref(locale, brand.page, id),
    label: `${name} (${families.reduce((sum, family) => sum + family.assets.length, 0)})`,
    current: id === brand.owner,
  }));
}
---

{[
  { id: headingId, heading, links },
  { id: `${headingId}-parts`, heading: t('component.parts'), links: parts },
].map(
  ({ id, heading, links }) =>
    links.length > 0 && (
      <nav class="not-first:mt-800" aria-labelledby={id}>
        <mds-text class="mb-400 block" id={id} typography="h5" tag="h2">
          {heading}
        </mds-text>
        {/* Labels lined up with the heading, as in SectionEntries.astro. */}
        <ul class="m-0 flex list-none flex-col items-start gap-100 p-0">
          {links.map((link) => (
            <li class="-ml-300 flex max-w-[calc(100%_+_--spacing(300))]">
              <mds-button
                class="max-w-full"
                href={link.href}
                role="link"
                type="a"
                aria-current={link.current ? 'page' : undefined}
                label={link.label}
                variant="dark"
                tone={link.current ? 'strong' : 'text'}
                size="sm"
                truncate="none"
              />
            </li>
          ))}
        </ul>
      </nav>
    ),
)}
