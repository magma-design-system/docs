---
// "Documentation" column of a component page: its sub-pages (src/lib/components.ts).
import { getEntry } from 'astro:content';
import { componentHref, pagesOf, parseComponentPath } from '../../lib/components';

interface Props {
  /** Unique per page: the component is rendered twice (frame and mobile menu). */
  headingId: string;
}

const { headingId } = Astro.props;
const { t, starlightRoute } = Astro.locals;
const { locale } = starlightRoute;
const path = parseComponentPath(Astro.url.pathname, locale);
const entry = path && (await getEntry('components', path.tag));
const pages = entry ? pagesOf(entry.data) : [];
---

{path && pages.length > 0 && (
  <nav aria-labelledby={headingId}>
    <mds-text id={headingId} typography="h5" tag="h2">
      {t('component.documentation')}
    </mds-text>
    <ul>
      {pages.map((page) => (
        <li>
          <mds-button
            href={componentHref(locale, path.tag, page.slug)}
            role="link"
            type="a"
            aria-current={page.slug === path.slug ? 'page' : undefined}
            label={t(page.label)}
            variant="dark"
            tone={page.slug === path.slug ? 'strong' : 'text'}
            size="sm"
          />
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  @layer components {
    mds-text {
      display: block;
      margin-bottom: 1rem;
    }

    ul {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
