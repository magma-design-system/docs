---
// Mobile and tablet header: brand and the menu button of mds-header. The menu
// holds what the desktop frame shows in its columns.
import Brand from './Brand.astro';
import DocsNav from './DocsNav.astro';
import SectionLinks from './SectionLinks.astro';
import SectionNav from './SectionNav.astro';

const { t } = Astro.locals;
---

<mds-header
  appearance="inline"
  menu="all"
  nav="none"
  data-menu-label={t('menuButton.accessibleLabel')}
>
  <mds-header-bar>
    <Brand />
  </mds-header-bar>
  <div slot="menu" class="menu">
    <SectionLinks />
    <DocsNav headingId="menu-docs-nav-heading" />
    <SectionNav headingId="menu-section-nav-heading" />
    <!-- Preferences.astro moves itself here below 64rem. -->
    <div data-preferences="menu"></div>
  </div>
</mds-header>

<script>
  // magma 2.0.1: the menu button of mds-header-bar is an icon-only mds-button
  // with an inline SVG icon, which gets neither role nor name. Give it a name.
  // Tracked in https://github.com/magma-design-system/magma/issues/821
  const header = document.querySelector<HTMLElement>('mds-header[data-menu-label]');
  const bar = header?.querySelector<HTMLElement & { componentOnReady?(): Promise<unknown> }>(
    'mds-header-bar',
  );
  customElements.whenDefined('mds-header-bar').then(async () => {
    await bar?.componentOnReady?.();
    bar?.shadowRoot
      ?.querySelector('[part="hamburger"]')
      ?.setAttribute('aria-label', header?.dataset.menuLabel ?? '');
  });

  // The menu opens at the top: bring the current page of the section into view,
  // a long list (the components) would hide it otherwise.
  document.addEventListener('mdsModalOpen', (event) => {
    if (event.target !== header) return;
    header
      ?.querySelector('.menu nav[data-section] [aria-current="page"]')
      ?.scrollIntoView({ block: 'center' });
  });
</script>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem;
  }
</style>
