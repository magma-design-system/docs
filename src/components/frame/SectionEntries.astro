---
// Links of a section, nested groups shown as sub-headings, each under its
// icon (GROUP_ICONS in src/lib/nav.mjs). The rail draws its groups with the
// same parts (NavList, NavHeading, NavLink). The links to a pattern or a block
// show it running small, a gallery of what the section holds.
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { parsePatternPath } from '../../lib/patterns';
import NavHeading from './NavHeading.astro';
import NavLink from './NavLink.astro';
import NavList from './NavList.astro';

interface Props {
  entries: StarlightRouteData['sidebar'];
  currentHref: string | undefined;
  /** The icon of each group, by its label. */
  icons: Map<string, string>;
}

const { entries, currentHref, icons } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
---

<NavList>
  {entries.map((entry) =>
    entry.type === 'link' ? (
      <NavLink
        href={entry.href}
        label={entry.label}
        current={entry.href === currentHref}
        preview={parsePatternPath(entry.href, locale)}
      />
    ) : (
      <li class="mt-600">
        <NavHeading icon={icons.get(entry.label)}>{entry.label}</NavHeading>
        <Astro.self entries={entry.entries} currentHref={currentHref} icons={icons} />
      </li>
    ),
  )}
</NavList>
