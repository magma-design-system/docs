---
// Desktop rail: brand, the search (SearchField.astro), the sections and
// the actions (repository, Storybook, preferences). Collapsed, it narrows to
// icons: the button that expands it again, the logo below it, then the search,
// the sections and the actions, each named by a tooltip (which Magma also
// makes its description: the same text twice, magma#923). The state is kept
// in localStorage and restored before the first paint (inline script below);
// the `rail-collapsed` variant (src/styles/magma.css) follows it.
//
// The preferences open in a dropdown next to the button that asks for them,
// in either form of the rail (Preferences.astro moves them in and out).
import { localePrefix } from '../../lib/frame';
import { REPOSITORY, STORYBOOK } from '../../lib/nav.mjs';
import Brand from './Brand.astro';
import Logo from './Logo.astro';
import Preferences from './Preferences.astro';
import SearchField from './SearchField.astro';
import SectionLinks from './SectionLinks.astro';

const { t, starlightRoute } = Astro.locals;

// The icon-only buttons of the collapsed rail: the search above the
// sections, the actions below them.
const search = {
  id: 'rail-search',
  icon: 'mi/baseline/search',
  label: t('search.label'),
  attributes: { type: 'button', 'data-search-trigger': true },
};
const actions = [
  {
    id: 'rail-repository',
    icon: 'mdi/github',
    label: t('frame.repository'),
    attributes: { type: 'a', href: REPOSITORY, target: 'blank', role: 'link' },
  },
  {
    id: 'rail-storybook',
    icon: 'mi/baseline/auto-stories',
    label: t('frame.storybook'),
    attributes: { type: 'a', href: STORYBOOK, target: 'blank', role: 'link' },
  },
  {
    id: 'rail-preferences',
    icon: 'mi/baseline/settings-accessibility',
    label: t('frame.preferences'),
    attributes: { type: 'button' },
  },
];
---

<script is:inline>
  // Same key as the toggle script below.
  try {
    if (localStorage.getItem('magma-docs:rail') === 'collapsed') {
      document.documentElement.dataset.rail = 'collapsed';
    }
  } catch {}
</script>

<div
  id="rail"
  class="flex w-full flex-col overflow-y-auto px-400 py-600 [scrollbar-width:thin] rail-collapsed:w-auto"
>
  <div class="flex flex-1 flex-col gap-1000 rail-collapsed:hidden">
    <div class="flex items-center justify-between gap-400">
      <Brand />
      <mds-button
        id="rail-collapse"
        data-rail-toggle="collapse"
        type="button"
        icon="mgg/action-hide-sidebar-left"
        aria-label={t('frame.rail.collapse')}
        aria-controls="rail"
        aria-expanded="true"
        variant="dark"
        tone="text"
        class="self-center"
      ></mds-button>
      <mds-tooltip target="#rail-collapse" placement="right" disable-auto-placement>
        {t('frame.rail.collapse')}
      </mds-tooltip>
    </div>
    <div class="flex flex-1 flex-col justify-between gap-1000">
      <div class="flex flex-col gap-600">
        <SearchField />
        <SectionLinks />
      </div>
      <div data-preferences="rail">
        <Preferences />
      </div>
    </div>
  </div>

  <div class="hidden flex-1 flex-col items-center gap-1000 rail-collapsed:flex">
    <div class="flex flex-col items-center gap-400 justify-center">
      <mds-button
        id="rail-expand"
        data-rail-toggle="expand"
        class="justify-self-center self-center"
        type="button"
        icon="mgg/action-show-sidebar-left"
        aria-label={t('frame.rail.expand')}
        aria-controls="rail"
        aria-expanded="false"
        variant="dark"
        tone="text"
      ></mds-button>
      <mds-tooltip target="#rail-expand" placement="right" disable-auto-placement>
        {t('frame.rail.expand')}
      </mds-tooltip>
      <a
        class="flex rounded-lg p-200 transition-cosmetic focus-bounce hover:bg-surface-muted hover:shadow-outline"
        href={`${localePrefix(starlightRoute.locale)}/`}
        aria-label={`Magma ${t('frame.brand.description')}`}
      >
        <Logo />
      </a>
    </div>
    <div class="flex flex-1 flex-col items-center justify-between gap-1000">
      <div class="flex flex-col items-center gap-600">
        <mds-button
          id={search.id}
          icon={search.icon}
          aria-label={search.label}
          variant="dark"
          tone="text"
          {...search.attributes}
        />
        <mds-tooltip target={`#${search.id}`} placement="right" disable-auto-placement>
          {search.label}
        </mds-tooltip>
        <SectionLinks compact />
      </div>
      <div class="flex flex-col items-center gap-200">
        {actions.map(({ id, icon, label, attributes }) => (
          <>
            <mds-button
              id={id}
              icon={icon}
              aria-label={label}
              variant="dark"
              tone="text"
              {...attributes}
            />
            <mds-tooltip target={`#${id}`} placement="right" disable-auto-placement>
              {label}
            </mds-tooltip>
          </>
        ))}
      </div>
    </div>
  </div>

  <!--
    One dropdown for the two preferences buttons: its target and its side
    follow the state of the rail (script below), above the button in the
    open rail, where on its right it would cover the buttons above, next to
    the icon in the collapsed one. `fixed`, or the rail, which scrolls,
    would clip it. A dialog, not the menu mds-dropdown makes of its content
    by default.
  -->
  <mds-dropdown
    data-preferences-dropdown
    class="p-400"
    target="#preferences-trigger"
    placement="top-start"
    disable-auto-placement
    strategy="fixed"
    offset="12"
    role="dialog"
  >
    <div class="min-w-2xs max-w-8000" data-preferences="dropdown"></div>
  </mds-dropdown>
</div>

<script>
  const STORAGE_KEY = 'magma-docs:rail';
  const root = document.documentElement;

  // The preferences open from the button of the rail on screen.
  const dropdown = document.querySelector('[data-preferences-dropdown]');
  const retarget = () => {
    const collapsed = root.dataset.rail === 'collapsed';
    dropdown?.setAttribute('target', collapsed ? '#rail-preferences' : '#preferences-trigger');
    dropdown?.setAttribute('placement', collapsed ? 'right-end' : 'top-start');
  };
  retarget();

  // The name of the icon would show over the open panel. (Not `invisible`:
  // Stencil's unlayered `[hydrated] { visibility: inherit }` wins over it.)
  const tooltip = document.querySelector('mds-tooltip[target="#rail-preferences"]');
  dropdown?.addEventListener('mdsDropdownChange', (event) => {
    const { visible } = (event as CustomEvent<{ visible: boolean }>).detail;
    tooltip?.classList.toggle('hidden', visible);
  });

  document.querySelectorAll('[data-rail-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const collapse = toggle.getAttribute('data-rail-toggle') === 'collapse';
      if (collapse) root.dataset.rail = 'collapsed';
      else delete root.dataset.rail;
      try {
        localStorage.setItem(STORAGE_KEY, collapse ? 'collapsed' : 'expanded');
      } catch {}
      retarget();
      // The toggle just clicked is hidden now: keep the focus on the other one.
      document
        .querySelector<HTMLElement>(`[data-rail-toggle="${collapse ? 'expand' : 'collapse'}"]`)
        ?.focus();
    });
  });
</script>
