---
// Desktop rail: brand, the 8 sections and the preferences. Collapsed, it keeps
// only the logo, which expands it again. The state is kept in localStorage and
// restored before the first paint (inline script below).
import Brand from './Brand.astro';
import Logo from './Logo.astro';
import Preferences from './Preferences.astro';
import SectionLinks from './SectionLinks.astro';

const { t } = Astro.locals;
---

<script is:inline>
  // Same key as the toggle script below.
  try {
    if (localStorage.getItem('magma-docs:rail') === 'collapsed') {
      document.documentElement.dataset.rail = 'collapsed';
    }
  } catch {}
</script>

<div class="rail">
  <div class="head">
    <div class="expanded">
      <Brand />
      <mds-button
        data-rail-toggle="collapse"
        type="button"
        icon="mi/baseline/arrow-back"
        aria-label={t('frame.rail.collapse')}
        aria-controls="rail-body"
        aria-expanded="true"
        variant="dark"
        tone="text"></mds-button>
    </div>
    <button
      class="collapsed"
      type="button"
      data-rail-toggle="expand"
      aria-label={t('frame.rail.expand')}
      aria-controls="rail-body"
      aria-expanded="false">
      <Logo />
    </button>
  </div>
  <div class="body" id="rail-body">
    <SectionLinks />
    <div data-preferences="rail"><Preferences /></div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'magma-docs:rail';
  const root = document.documentElement;

  document.querySelectorAll('[data-rail-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const collapse = toggle.getAttribute('data-rail-toggle') === 'collapse';
      if (collapse) root.dataset.rail = 'collapsed';
      else delete root.dataset.rail;
      try {
        localStorage.setItem(STORAGE_KEY, collapse ? 'collapsed' : 'expanded');
      } catch {}
      // The toggle just clicked is hidden now: keep the focus on the other one.
      document.querySelector<HTMLElement>(`[data-rail-toggle="${collapse ? 'expand' : 'collapse'}"]`)?.focus();
    });
  });
</script>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 15rem;
    padding: 1.5rem 1rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .expanded {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .collapsed {
    display: none;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: none;
    cursor: pointer;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  :global([data-rail='collapsed']) .rail {
    width: auto;
  }

  :global([data-rail='collapsed']) .expanded,
  :global([data-rail='collapsed']) .body {
    display: none;
  }

  :global([data-rail='collapsed']) .collapsed {
    display: inline-flex;
  }

  .collapsed:focus-visible {
    outline: var(--magma-outline-focus);
    outline-offset: var(--magma-outline-focus-offset);
  }
</style>
