---
// Starlight's <head> plus Astro's ClientRouter: pages change in place, without
// a reload, and the frame columns marked `transition:persist` stay mounted
// (PageFrame.astro).
//
// Starlight has no og:image: every page gets the site cover
// (public/covers/), unless its frontmatter `head` sets its own.
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

const { head } = Astro.locals.starlightRoute;
const ownImage = head.some(({ attrs }) => attrs?.property === 'og:image');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cover = new URL(`${base}covers/og-1200x630.png`, Astro.site).href;
---

<Default />
{!ownImage && (
  <>
    <meta property="og:image" content={cover} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={Astro.locals.t('frame.cover.alt')} />
  </>
)}
<ClientRouter />
