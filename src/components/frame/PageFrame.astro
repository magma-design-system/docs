---
// The frame of every page, replacing Starlight's (layout mockups in
// plan/CONTENT_STRUCTURE.md). Desktop: rail on the page background, then a card
// with the section navigation, the content and the right column. Below 64rem:
// the mobile header (Header.astro) with everything else in its menu, the right
// column down to 48rem.
//
// Under the card, on the page background like the rail: the footer of the
// site (SiteFooter.astro).
//
// Pages change in place (Astro's ClientRouter, Head.astro). The columns marked
// `transition:persist` stay mounted from page to page while their links are
// the same (script below): their Magma components do not hydrate again, the
// columns keep their scroll position.
//
// The rail is sticky, so its own stacking context: on Magma's header layer,
// its dropdown and tooltips show over the card (whose sticky columns would
// paint over them otherwise), under what floats from the content.
import Search from '@astrojs/starlight/components/Search.astro';
import Rail from './Rail.astro';
import SiteFooter from './SiteFooter.astro';

const { hasSidebar, entry } = Astro.locals.starlightRoute;
// A page with a hero: the card is a container, for the hero to reach its edges (Hero.astro).
const hasHero = Boolean(entry.data.hero);
---

<div
  data-frame
  class="pt-(--frame-header-height) desktop:grid desktop:min-h-screen desktop:grid-cols-[230px_minmax(0,4fr)] desktop:rail-collapsed:grid-cols-[auto_minmax(0,1fr)]"
>
  <div data-frame-header class="desktop:hidden print:hidden">
    <slot name="header" />
  </div>
  <div
    data-frame-rail
    transition:persist="frame-rail"
    class="hidden desktop:sticky desktop:top-0 desktop:z-(--magma-header-z-index) desktop:flex desktop:h-screen print:hidden"
  >
    <Rail />
  </div>
  <div class="min-w-0 desktop:me-400">
    <div
      class:list={[
        'desktop:mt-400 desktop:grid desktop:rounded-2xl desktop:border desktop:border-border-muted desktop:bg-surface-raised',
        hasHero && '@container',
        hasSidebar
          ? 'desktop:grid-cols-[1fr_minmax(0,4fr)] desktop:gap-x-800'
          : 'desktop:grid-cols-[minmax(0,1fr)]',
      ]}
    >
      {hasSidebar && (
        <div
          data-frame-section
          transition:persist="frame-section"
          class="hidden desktop:sticky desktop:top-(--frame-sticky-top) desktop:block desktop:max-h-[calc(100vh-var(--frame-sticky-top))] desktop:self-start desktop:overflow-y-auto desktop:py-800 desktop:ps-800 [scrollbar-width:thin] print:hidden"
        >
          <slot name="sidebar" />
        </div>
      )}
      <div class:list={[!hasSidebar && 'desktop:px-800']}>
        <slot />
      </div>
    </div>
    <SiteFooter />
  </div>
</div>

<!--
  Pagefind search: one dialog, opened by the search buttons of the rail and of
  the menu. Kept across pages: Starlight sets it up once, on DOMContentLoaded.
-->
<div data-frame-search transition:persist="frame-search" class="print:hidden">
  <Search />
</div>

<script>
  import {
    navigate,
    type TransitionBeforePreparationEvent,
    type TransitionBeforeSwapEvent,
  } from 'astro:transitions/client';
  import { NavigationService } from '@maggioli-design-system/magma/services';

  const PERSIST = 'data-astro-transition-persist';

  // The links of the components (mds-button, mds-link, mds-tab-item) are anchors in
  // their shadow roots, which the router does not see: Magma hands it their
  // plain clicks within the site. Anchors of this page stay with the browser.
  NavigationService.setHandler((href) => {
    const url = new URL(href, location.href);
    if (url.pathname === location.pathname && url.hash) return false;
    navigate(url.href);
  });

  // Another language is a full load: the columns and the search kept by the
  // router are in the language of this page.
  document.addEventListener('astro:before-preparation', (event) => {
    const preparation = event as TransitionBeforePreparationEvent;
    const load = preparation.loader;
    preparation.loader = async () => {
      await load();
      if (preparation.newDocument.documentElement.lang !== document.documentElement.lang) {
        preparation.preventDefault();
      }
    };
  });

  /** Links of a column, in order: the same links make the same column. */
  const links = (column: ParentNode) => [
    ...column.querySelectorAll<HTMLElement>('nav mds-button[href]'),
  ];
  const hrefs = (column: ParentNode) => links(column).map((link) => link.getAttribute('href'));

  /** Scroll positions in the kept columns, put back after the swap. */
  const scrolled = new Map<Element, [top: number, left: number]>();

  document.addEventListener('astro:before-swap', (event) => {
    const next = (event as TransitionBeforeSwapEvent).newDocument;

    // <html> takes the attributes of the new page: keep the ones set on this
    // side (mode and theme, ThemeProvider.astro, mds-pref-mode and
    // mds-pref-theme; rail, Rail.astro).
    const root = document.documentElement;
    for (const name of ['data-theme', 'data-theme-name', 'data-magma-pref', 'data-rail']) {
      const value = root.getAttribute(name);
      if (value === null) next.documentElement.removeAttribute(name);
      else next.documentElement.setAttribute(name, value);
    }
    next.documentElement.classList.add(
      ...[...root.classList].filter((name) => /^pref-(mode|theme)-/.test(name)),
    );
    for (const property of [
      '--magma-pref-mode',
      '--magma-pref-theme',
      '--magma-pref-theme-scheme',
    ]) {
      const value = root.style.getPropertyValue(property);
      if (value) next.documentElement.style.setProperty(property, value);
    }

    // A column is kept when the new page has the same links in it, and only
    // which one is current changes. Other links (another section, another
    // component, the table of contents of a page) make a new column.
    scrolled.clear();
    const copies: Element[] = [];
    for (const column of next.querySelectorAll(`[${PERSIST}]`)) {
      const kept = document.querySelector(`[${PERSIST}="${column.getAttribute(PERSIST)}"]`);
      if (!kept) continue;
      const nextHrefs = hrefs(column);
      if (
        nextHrefs.some((href) => href?.startsWith('#')) ||
        nextHrefs.join() !== hrefs(kept).join()
      ) {
        column.removeAttribute(PERSIST);
        continue;
      }
      const nextLinks = links(column);
      links(kept).forEach((link, i) => {
        for (const name of ['aria-current', 'tone']) {
          const value = nextLinks[i].getAttribute(name);
          if (value === null) link.removeAttribute(name);
          else link.setAttribute(name, value);
        }
      });
      for (const element of [kept, ...kept.querySelectorAll('*')]) {
        if (element.scrollTop || element.scrollLeft) {
          scrolled.set(element, [element.scrollTop, element.scrollLeft]);
        }
      }
      copies.push(column);
    }

    // The router puts the new page in, then the kept columns in place of
    // their copies: for that moment the copies are on the page, and their
    // components start loading for nothing. mds-dropdown (magma 2.5.0; no
    // longer mds-tooltip) then throws, taken off the page before it has loaded
    // (https://github.com/magma-design-system/magma/issues/527). Emptied once
    // every listener has read the new page, right before the swap.
    const swap = (event as TransitionBeforeSwapEvent).swap;
    (event as TransitionBeforeSwapEvent).swap = () => {
      for (const copy of copies) copy.replaceChildren();
      swap();
    };
  });

  type MagmaElement = HTMLElement & { componentOnReady?(): Promise<unknown> };

  /**
   * The current page of the section navigation and of the right column in
   * view, once their links have their height.
   */
  const showCurrent = () =>
    Promise.all(
      [...document.querySelectorAll<HTMLElement>('[data-frame-section], [data-frame-aside]')].map(
        async (column) => {
          if (column.getClientRects().length === 0) return;
          await Promise.all(
            [...column.querySelectorAll<MagmaElement>('mds-button')].map(async (element) => {
              await customElements.whenDefined(element.localName);
              await element.componentOnReady?.();
            }),
          );
          const current = column.querySelector('[aria-current="page"]');
          if (!current) return;
          const view = column.getBoundingClientRect();
          const item = current.getBoundingClientRect();
          if (item.top < view.top || item.bottom > view.bottom) {
            column.scrollTop += item.top - view.top - (view.height - item.height) / 2;
          }
        },
      ),
    );

  document.addEventListener('astro:after-swap', () => {
    // The kept columns lose their scroll position on the move, also with
    // `moveBefore` (Chromium 152): put it back before the new page is shown.
    for (const [element, [top, left]] of scrolled) {
      element.scrollTop = top;
      element.scrollLeft = left;
    }
    scrolled.clear();
    showCurrent();
  });
  showCurrent();
</script>
