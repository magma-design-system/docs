---
// The frame of every page, replacing Starlight's (layout mockups in
// plan/CONTENT_STRUCTURE.md). Desktop: rail on the page background, then a card
// with the section navigation, the content and the right column. Below 64rem:
// the mobile header (Header.astro) with everything else in its menu, the right
// column down to 48rem.
import Search from '@astrojs/starlight/components/Search.astro';
import Rail from './Rail.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<script is:inline>
  // Every navigation loads a new page, and Magma's components stay hidden until
  // they hydrate: painted at once, the frame would show up ~100ms after the
  // content. On navigations within the site, hold the page until the frame is
  // ready (module script below): the browser keeps the previous page on screen
  // meanwhile. A first visit is not held, its assets are not cached yet. The
  // timeout reveals the page anyway; without JavaScript nothing is held.
  if (document.referrer.startsWith(location.origin)) {
    document.documentElement.dataset.framePending = '';
    setTimeout(() => delete document.documentElement.dataset.framePending, 1000);
  }
</script>

<div class="frame">
  <div class="header print:hidden">
    <slot name="header" />
  </div>
  <div class="rail print:hidden">
    <Rail />
  </div>
  <div class="card">
    {hasSidebar && (
      <div class="section-column print:hidden">
        <slot name="sidebar" />
      </div>
    )}
    <div class="main-frame">
      <slot />
    </div>
  </div>
</div>

<!-- Pagefind search: one dialog, opened by the search buttons of the rail and of the menu. -->
<div class="search print:hidden">
  <Search />
</div>

<script>
  // Each page is a new document, so the section navigation would start from the
  // top on every page: a long list (the components) loses its place. Keep its
  // scroll position for the section in sessionStorage.
  const SCROLL_KEY = 'magma-docs:section-scroll';
  const column = document.querySelector<HTMLElement>('.section-column');
  const section = column?.querySelector<HTMLElement>('nav[data-section]')?.dataset.section;

  window.addEventListener('pagehide', () => {
    if (!column || !section) return;
    try {
      sessionStorage.setItem(SCROLL_KEY, JSON.stringify({ section, top: column.scrollTop }));
    } catch {}
  });

  /** Back to the stored position, then the current page in view if it is not. */
  const restoreScroll = () => {
    if (!column || !section || column.getClientRects().length === 0) return;
    try {
      const stored = JSON.parse(sessionStorage.getItem(SCROLL_KEY) ?? 'null');
      if (stored?.section === section) column.scrollTop = stored.top;
    } catch {}
    const current = column.querySelector('[aria-current="page"]');
    if (!current) return;
    const view = column.getBoundingClientRect();
    const item = current.getBoundingClientRect();
    if (item.top < view.top || item.bottom > view.bottom) {
      column.scrollTop += item.top - view.top - (view.height - item.height) / 2;
    }
  };

  // Reveal the page once the Magma components of the frame shown at this width
  // have hydrated (the inline script at the top holds it): only then the
  // section navigation has its final height and its scroll can be restored.
  type MagmaElement = HTMLElement & { componentOnReady?(): Promise<unknown> };
  const shown = [
    ...document.querySelectorAll<MagmaElement>(
      '.frame :is(.header, .rail, .section-column, .right-column) *',
    ),
  ].filter(
    (element) => element.localName.startsWith('mds-') && element.getClientRects().length > 0,
  );
  Promise.all(
    shown.map(async (element) => {
      await customElements.whenDefined(element.localName);
      await element.componentOnReady?.();
    }),
  )
    .then(restoreScroll)
    .finally(() => delete document.documentElement.dataset.framePending);
</script>

<style is:global>
  :root:root {
    --frame-header-height: 5.5rem;
    --frame-column-width: 13rem;
    --frame-gap: 2rem;
    --frame-pad: 1.5rem;

    /* Starlight: anchors land below the header, no mobile table of contents. */
    --sl-nav-height: var(--frame-header-height);
    --sl-mobile-toc-height: 0rem;
    --sl-content-margin-inline: 0;
    --sl-content-pad-x: var(--frame-pad);
  }

  @media (min-width: 64rem) {
    :root:root {
      --frame-header-height: 0rem;
      --frame-pad: 2rem;
      /* The column gap already separates the content from the section navigation. */
      --sl-content-pad-x: 0rem;
    }
  }

  /* No rule between the page title and the content. */
  .main-pane .content-panel + .content-panel {
    border-top: 0;
  }

  body {
    background-color: rgb(var(--surface-neutral-raised));
    color: rgb(var(--text-neutral-default));
  }

  /* Until the frame has hydrated: see the inline script at the top of the frame. */
  :root[data-frame-pending] body {
    visibility: hidden;
  }

  @media (min-width: 64rem) {
    body {
      background-color: rgb(var(--surface-neutral-default));
    }
  }

  /* Starlight's trigger is replaced by the frame's buttons, its dialog is kept. */
  .search site-search > button[data-open-modal] {
    display: none;
  }
</style>

<style>
  .frame {
    padding-top: var(--frame-header-height);
  }

  .rail,
  .section-column {
    display: none;
  }

  @media (min-width: 64rem) {
    .header {
      display: none;
    }

    .frame {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      min-height: 100vh;
    }

    .rail {
      display: flex;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .card {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin: 1rem 1rem 1rem 0;
      border: 1px solid rgb(var(--border-neutral-muted));
      border-radius: var(--radius-2xl);
      background-color: rgb(var(--surface-neutral-raised));
    }

    .card:has(.section-column) {
      grid-template-columns: var(--frame-column-width) minmax(0, 1fr);
      column-gap: var(--frame-gap);
    }

    .card:not(:has(.section-column)) .main-frame {
      padding-inline-start: var(--frame-pad);
    }

    .section-column {
      display: block;
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      padding: var(--frame-pad) 0 var(--frame-pad) var(--frame-pad);
      scrollbar-width: thin;
    }
  }
</style>
