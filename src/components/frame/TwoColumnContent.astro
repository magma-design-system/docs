---
// Page content and the right column (PageSidebar), inside the card.
import { parseComponentPath } from '../../lib/components';

const { toc, locale } = Astro.locals.starlightRoute;
const hasRightColumn = Boolean(toc) || parseComponentPath(Astro.url.pathname, locale) !== undefined;
---

<div
  class:list={[
    hasRightColumn && 'tablet:grid tablet:grid-cols-[minmax(0px,720px)_200px] tablet:gap-0',
  ]}
>
  <div data-frame-main>
    <slot />
  </div>
  {hasRightColumn && (
    <div
      data-frame-aside
      transition:persist="frame-aside"
      class="hidden tablet:sticky tablet:top-(--frame-sticky-top) tablet:block tablet:max-h-[calc(100vh-var(--frame-sticky-top))] tablet:self-start tablet:overflow-y-auto tablet:p-600 desktop:p-800 [scrollbar-width:thin] print:hidden"
    >
      <slot name="right-sidebar" />
    </div>
  )}
</div>
