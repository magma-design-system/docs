---
// Page content and the right column (PageSidebar), inside the card.
import HeadingAnchors from '../HeadingAnchors.astro';
import { parseBrandPath } from '../../lib/brand-pages';
import { parseComponentPath } from '../../lib/components';
import { parseIconSetPath } from '../../lib/icon-pages';

const { toc, locale } = Astro.locals.starlightRoute;
const hasRightColumn =
  Boolean(toc) ||
  parseComponentPath(Astro.url.pathname, locale) !== undefined ||
  (parseIconSetPath(Astro.url.pathname, locale)?.categories.length ?? 0) > 0 ||
  (parseBrandPath(Astro.url.pathname, locale)?.owners.length ?? 0) > 0;
---

<div
  class:list={[
    hasRightColumn &&
      'tablet:grid tablet:grid-cols-[minmax(0px,720px)_minmax(240px,1fr)] tablet:gap-0',
  ]}
>
  <div data-frame-main>
    <slot />
    <HeadingAnchors />
  </div>
  {hasRightColumn && (
    <div
      data-frame-aside
      transition:persist="frame-aside"
      class="w-full hidden tablet:sticky tablet:top-(--frame-sticky-top) tablet:block tablet:max-h-[calc(100vh-var(--frame-sticky-top))] tablet:self-start tablet:overflow-y-auto tablet:p-600 desktop:p-800 [scrollbar-width:thin] print:hidden"
    >
      <slot name="right-sidebar" />
    </div>
  )}
</div>
