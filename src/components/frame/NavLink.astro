---
// A link of the frame's menus, in a NavList.astro: a small button, the
// selected one strong.
//
// The item is a flex box: in a block, the button would sit on a line of text,
// whose line height adds space below it to the gap. It is pulled left by the
// padding of the button, so that its label lines up with the headings
// (NavHeading.astro) and the background of the selected or hovered one stands
// out of the column. A pattern or a block shows a small preview of itself
// above the button (MiniPreview.astro), as wide as the column.
import MiniPreview from '../MiniPreview.astro';
import { navPreviewQuery, type PatternKind } from '../../lib/patterns';

interface Props {
  href: string;
  label: string;
  current: boolean;
  /** Long labels wrap rather than end in an ellipsis (the right column). */
  wrap?: boolean;
  /** The pattern or block the link leads to, shown small above it. */
  preview?: { id: string; kind: PatternKind };
  class?: string;
}

const { href, label, current, wrap = false, preview, class: className } = Astro.props;
---

<li
  class:list={[
    '-ml-300 flex',
    wrap && 'max-w-[calc(100%_+_--spacing(300))]',
    preview && 'mb-400 flex-col gap-200',
    className,
  ]}
>
  {preview && (
    <MiniPreview
      id={preview.id}
      kind={preview.kind}
      query={navPreviewQuery(preview.id, preview.kind)}
      href={href}
      class="ms-300"
    />
  )}
  <mds-button
    class="max-w-full self-start"
    href={href}
    type="a"
    aria-current={current ? 'page' : undefined}
    label={label}
    variant="dark"
    tone={current ? 'strong' : 'text'}
    size="sm"
    truncate={wrap ? 'none' : undefined}
  />
</li>
