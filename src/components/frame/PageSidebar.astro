---
// Right column: the sub-pages column on component, pattern and block pages
// ("Documentation"),
// icon set pages ("Categories") and Brand assets pages with more than one
// owner ("Brands"), the table of contents with the reading indicator
// elsewhere. Hidden on mobile, as in the layout mockups.
import { parseBrandPath } from '../../lib/brand-pages';
import { parseComponentPath } from '../../lib/components';
import { parseIconSetPath } from '../../lib/icon-pages';
import { parsePatternPath } from '../../lib/patterns';
import DocsNav from './DocsNav.astro';
import TableOfContents from './TableOfContents.astro';

const { toc, locale } = Astro.locals.starlightRoute;
const hasSubPages =
  parseComponentPath(Astro.url.pathname, locale) !== undefined ||
  parsePatternPath(Astro.url.pathname, locale) !== undefined ||
  (parseIconSetPath(Astro.url.pathname, locale)?.categories.length ?? 0) > 0 ||
  (parseBrandPath(Astro.url.pathname, locale)?.owners.length ?? 0) > 0;
---

{hasSubPages ? <DocsNav headingId="docs-nav-heading" /> : toc && <TableOfContents />}
