---
// How Tailwind 4 reads the tokens, from styles' consumption map
// (src/lib/tokens.mjs): `namespaces`, the theme namespaces with how many
// tokens each publishes and the utilities and variants that read them;
// `shadowed`, the classes that read another variable than the token of the
// same key; `unread`, the tokens no utility reads; `utilities`, the
// `@utility` classes of styles and design-tokens. Values are copied on click
// (CopyToClipboard.astro, once per page).
import Code from './Code.astro';
import CopyStatus from './CopyStatus.astro';
import { consumption, shadowedClasses, tailwindOf } from '../lib/tokens.mjs';

interface Props {
  part: 'namespaces' | 'shadowed' | 'unread' | 'utilities';
}

const { part } = Astro.props;
const { t } = Astro.locals;
const map = consumption();
const entries = Object.entries(map.tokens) as [string, any][];

/** The first classes of a long list, and how many are left out. */
const SHOWN = 12;
const shortList = (names: string[]) => ({
  shown: names.slice(0, SHOWN),
  more: Math.max(0, names.length - SHOWN),
});

const namespaces = Object.entries(map.namespaces as Record<string, any>).map(([name, ns]) => ({
  name,
  count: entries.filter(([, e]) => e.namespace === name && !e.property).length,
  ...shortList([
    ...(ns.variants as string[]).map((variant) => `${variant}:`),
    // The negative roots (`-mt`) after the others.
    ...(ns.utilities as string[])
      .toSorted((a, b) => Number(a.startsWith('-')) - Number(b.startsWith('-')))
      .map((root) => `${root}-*`),
  ]),
}));
const shadowed = shadowedClasses();
const unread = entries
  .filter(([, e]) => e.namespace === null)
  .map(([css, e]) => ({ css, theme: e.theme as string, utility: tailwindOf({ css })?.utility }));
const utilities = Object.entries(map.utilities as Record<string, any>).map(([name, u]) => ({
  name,
  source: String(u.source).replace('@maggioli-design-system/', ''),
  tokens: [...(u.tokens ?? []), ...(u.theme ?? [])] as string[],
}));
const CELL = 'whitespace-nowrap';
const LIST = 'min-w-prose';
---

{part === 'namespaces' && (
  <mds-table>
    <mds-table-header>
      <mds-table-header-cell label={t('tokens.column.namespace')} />
      <mds-table-header-cell label={t('tokens.column.tokens')} />
      <mds-table-header-cell label={t('tokens.column.reads')} />
    </mds-table-header>
    <mds-table-body>
      {namespaces.map((ns) => (
        <mds-table-row>
          <mds-table-cell class={CELL}>
            <Code name>{`${ns.name}-*`}</Code>
          </mds-table-cell>
          <mds-table-cell class={CELL}>
            <mds-text typography="detail" tag="span" class="whitespace-nowrap">
              {ns.count}
            </mds-text>
          </mds-table-cell>
          <mds-table-cell class={LIST}>
            <span class="flex flex-wrap items-center gap-100">
              {ns.shown.map((name) => (
                <Code>{name}</Code>
              ))}
              {ns.more > 0 && (
                <mds-text typography="caption" tag="span" class="my-0 text-fg-muted">
                  {t('tokens.tailwind.more', { count: ns.more })}
                </mds-text>
              )}
            </span>
          </mds-table-cell>
        </mds-table-row>
      ))}
    </mds-table-body>
  </mds-table>
)}

{part === 'shadowed' && (
  <mds-table interactive>
    <mds-table-header>
      <mds-table-header-cell label={t('tokens.column.class')} />
      <mds-table-header-cell label={t('tokens.column.readsInstead')} />
      <mds-table-header-cell label={t('tokens.column.notToken')} />
    </mds-table-header>
    <mds-table-body>
      {shadowed.map((row) => (
        <mds-table-row data-copy-scope>
          <mds-table-cell class={CELL}>
            <Code name copy={row.root}>
              {row.root}
            </Code>
          </mds-table-cell>
          <mds-table-cell class={CELL}>
            {row.reads ? (
              <Code copy={row.reads}>{row.reads}</Code>
            ) : (
              <mds-text typography="detail" tag="span" class="whitespace-nowrap text-fg-muted">
                {t('tokens.shadowed.none')}
              </mds-text>
            )}
          </mds-table-cell>
          <mds-table-cell class={CELL}>
            <Code copy={row.css}>{row.css}</Code>
          </mds-table-cell>
          <CopyStatus />
        </mds-table-row>
      ))}
    </mds-table-body>
  </mds-table>
)}

{part === 'unread' && (
  <mds-table interactive>
    <mds-table-header>
      <mds-table-header-cell label={t('tokens.column.token')} />
      <mds-table-header-cell label={t('tokens.column.arbitrary')} />
    </mds-table-header>
    <mds-table-body>
      {unread.map((row) => (
        <mds-table-row data-copy-scope>
          <mds-table-cell class={CELL}>
            <Code name copy={row.css}>
              {row.css}
            </Code>
          </mds-table-cell>
          <mds-table-cell class={CELL}>
            {row.utility ? (
              <Code copy={row.utility}>{row.utility}</Code>
            ) : (
              <mds-text typography="detail" tag="span" class="whitespace-nowrap text-fg-muted">
                -
              </mds-text>
            )}
          </mds-table-cell>
          <CopyStatus />
        </mds-table-row>
      ))}
    </mds-table-body>
  </mds-table>
)}

{part === 'utilities' && (
  <mds-table interactive>
    <mds-table-header>
      <mds-table-header-cell label={t('tokens.column.class')} />
      <mds-table-header-cell label={t('tokens.column.reads')} />
      <mds-table-header-cell label={t('tokens.column.source')} />
    </mds-table-header>
    <mds-table-body>
      {utilities.map((row) => (
        <mds-table-row data-copy-scope>
          <mds-table-cell class={CELL}>
            <Code name copy={row.name}>
              {row.name}
            </Code>
          </mds-table-cell>
          <mds-table-cell class={LIST}>
            <span class="flex flex-wrap gap-100">
              {row.tokens.length ? (
                row.tokens.map((token) => <Code>{token}</Code>)
              ) : (
                <mds-text typography="detail" tag="span" class="whitespace-nowrap text-fg-muted">
                  -
                </mds-text>
              )}
            </span>
          </mds-table-cell>
          <mds-table-cell class={CELL}>
            <Code>{row.source}</Code>
          </mds-table-cell>
          <CopyStatus />
        </mds-table-row>
      ))}
    </mds-table-body>
  </mds-table>
)}
