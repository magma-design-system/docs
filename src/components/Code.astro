---
// Inline code as mds-text with Magma's look for code, as the Markdown pages
// have it (src/lib/markdown-text.mjs): `hack`, without the ring, on a light
// background. `name`: what a table row is about, in bold and without
// background. `copy`: the text copied when it is clicked
// (CopyToClipboard.astro).
import { TEXT } from '../lib/markdown-text.mjs';

interface Props {
  name?: boolean;
  copy?: string;
}

const { name = false, copy } = Astro.props;
---

<mds-text typography="hack" tag="code" class={name ? TEXT.name : TEXT.code} data-copy={copy}>
  {name ? (
    <strong>
      <slot />
    </strong>
  ) : (
    <slot />
  )}
</mds-text>
