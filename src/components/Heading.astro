---
// A section heading of a page written in .astro, as the Markdown headings are
// (src/lib/markdown-text.mjs): marked as a section, so the reading bar names
// it and copies the link to it (TwoColumnContent.astro).
// `typography`: the heading's look, its tag's by default.
import { SECTION, TEXT } from '../lib/markdown-text.mjs';

interface Props {
  id: string;
  text: string;
  level?: 2 | 3;
  typography?: string;
}

const { id, text, level = 2 } = Astro.props;
const tag = `h${level}` as const;
const { typography = tag } = Astro.props;
---

<mds-text id={id} typography={typography} tag={tag} class={TEXT.heading[tag]} {...SECTION}>
  {text}
</mds-text>
