---
// The gallery of the landing page of Patterns or Building blocks: what the
// installed magma ships of that kind, by topic, in the groups and the order of
// the section navigation (patternGroups() in src/lib/nav.mjs), each topic under
// a heading that the table of contents lists (src/route-data.ts). One card
// each: its media, its title and its need as the package writes them, in
// English, and its id, which an agent and a product's layer use. A candidate,
// a need Magma knows with no default yet, has a badge.
//
// The media is the image of the first preview, the one Magma ships beside its
// stage, light or dark as the page (previewImageHref() in src/lib/patterns.ts):
// a WebP of a few KB, where running the stage in a frame would load a whole
// page per card. The hidden one is not loaded (`loading` is lazy). A candidate
// has no preview: its media is the icon of its group, on the neutral surface
// of mds-card-media.
import { getEntry } from 'astro:content';
import { patternGroups } from '../lib/nav.mjs';
import { patternHref, previewImageHref } from '../lib/patterns';
import Code from './Code.astro';
import Heading from './Heading.astro';

interface Props {
  kind: 'pattern' | 'block';
}

const { kind } = Astro.props;
const { t, starlightRoute } = Astro.locals;
const { locale } = starlightRoute;
const section = kind === 'block' ? 'blocks' : 'patterns';
// What comes from the Magma packages is in English only.
const contentLang = locale ? 'en' : undefined;

const groups = await Promise.all(
  patternGroups(kind).map(async (group) => ({
    id: group.id,
    icon: group.icon,
    label: t(`nav.${section}.${group.id}` as any),
    items: await Promise.all(
      group.patterns.map(async ({ id, title, status }) => {
        const entry = await getEntry('patterns', id);
        if (!entry) throw new Error(`PatternGallery: no pattern ${id}`);
        const first = entry.data.parts.flatMap((part) => part.previews)[0];
        return {
          id,
          title,
          candidate: status === 'candidate',
          need: entry.data.need,
          href: patternHref(locale, kind, id),
          images: first && {
            light: previewImageHref(kind, id, first.id, 'light'),
            dark: previewImageHref(kind, id, first.id, 'dark'),
          },
        };
      }),
    ),
  })),
);
---

{groups.map(({ id, icon, label, items }) => (
  <>
    <Heading id={id} text={label} />
    {/* `not-content`: Starlight would put 1rem above every card but the first. */}
    <div class="not-content @container my-600">
      <div class="grid gap-600 @xl:grid-cols-2">
        {items.map((item) => (
          <mds-card class="bg-surface-overlay">
            <mds-card-media>
              {item.images ? (
                <>
                  <mds-img
                    class="aspect-8/5 [--mds-img-background:transparent] dark:hidden"
                    src={item.images.light}
                    alt=""
                    width="1440"
                    height="900"
                  />
                  <mds-img
                    class="hidden aspect-8/5 [--mds-img-background:transparent] dark:flex"
                    src={item.images.dark}
                    alt=""
                    width="1440"
                    height="900"
                  />
                </>
              ) : (
                <div aria-hidden="true" class="grid aspect-8/5 w-full place-items-center">
                  <mds-icon name={icon} class="w-1200 fill-current text-fg-muted" />
                </div>
              )}
            </mds-card-media>
            <mds-card-header class="flex-wrap items-center gap-200 bg-surface-overlay">
              <mds-text typography="h6" tag="h3" lang={contentLang}>
                {item.title}
              </mds-text>
              {item.candidate && (
                <mds-badge label={t('pattern.candidate')} variant="info" tone="weak" />
              )}
            </mds-card-header>
            <mds-card-content class="flex flex-col gap-300 bg-surface-overlay">
              <mds-text typography="detail" tag="p" lang={contentLang}>
                {item.need}
              </mds-text>
              <mds-text typography="detail" tag="p">
                <mds-text typography="detail" tag="span" class="text-fg-muted">
                  {t('pattern.id')}:
                </mds-text>{' '}
                <Code>{item.id}</Code>
              </mds-text>
            </mds-card-content>
            <mds-card-footer class="bg-surface-overlay">
              <mds-button
                href={item.href}
                type="a"
                label={t('cards.open')}
                aria-label={`${t('cards.open')}: ${item.title}`}
                icon="mi/baseline/arrow-forward"
                icon-position="right"
                variant="primary"
                tone="text"
              />
            </mds-card-footer>
          </mds-card>
        ))}
      </div>
    </div>
  </>
))}
