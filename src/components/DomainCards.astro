---
// The group Composition of the landing page of Foundation: its heading and a
// card per domain of the design language the installed magma ships, in the
// order of the navigation (DOMAINS in src/lib/nav.mjs). Nothing at all with a
// magma that ships none; the table of contents lists the heading only when it
// shows (src/route-data.ts).
import Heading from './Heading.astro';
import PageCards from './PageCards.astro';
import { COMPOSITION } from '../lib/patterns';
import { shippedDomains } from '../lib/nav.mjs';

const { t } = Astro.locals;
const domains = shippedDomains();
---

{domains.length > 0 && (
  <>
    <Heading id={COMPOSITION} text={t('nav.foundation.composition')} />
    <PageCards pages={domains.map(({ id, icon }) => ({ domain: id, icon }))} />
  </>
)}
