---
// The code of a pattern or a block in each framework, in the tabs of
// FrameworkTabs: the files of its folder in src/patterns/ or src/blocks/ as
// they are (src/lib/patterns.ts), each named after it the way its framework
// names a file. A sketch with the plain HTML version only shows it alone,
// without tabs.
import { Code as CodeBlock } from '@astrojs/starlight/components';
import { patternCode, type PatternKind } from '../lib/patterns';
import FrameworkTabs from './FrameworkTabs.astro';

interface Props {
  /** The folder of the pattern in src/patterns/, or of the block in src/blocks/. */
  id: string;
  kind?: PatternKind;
}

const { id, kind = 'patterns' } = Astro.props;
const code = patternCode(id, kind);
const pascal = id.replace(/(?:^|-)([a-z])/g, (_, letter: string) => letter.toUpperCase());
---

{code.react && code.angular ? (
  <FrameworkTabs>
    <Fragment slot="vanilla">
      <CodeBlock code={code.vanilla!.code} lang={code.vanilla!.lang} title={`${id}.html`} />
    </Fragment>
    <Fragment slot="react">
      <CodeBlock code={code.react.code} lang={code.react.lang} title={`${pascal}.tsx`} />
    </Fragment>
    <Fragment slot="angular">
      <CodeBlock code={code.angular.code} lang={code.angular.lang} title={`${id}.component.ts`} />
    </Fragment>
  </FrameworkTabs>
) : (
  <CodeBlock code={code.vanilla!.code} lang={code.vanilla!.lang} title={`${id}.html`} />
)}
