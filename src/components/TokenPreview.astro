---
// A token applied to a small sample (previewOf in src/lib/tokens.mjs): a
// swatch, a box with the shadow, the radius, the outline or the opacity, a
// bar as long as the space, a dot that crosses its box in a duration, the
// curve of an easing over a dot that moves with it (script below); "N/A" in
// the space of a swatch for what cannot
// be drawn (a layer, a blur). Painted with the custom property itself wherever the
// page has it, so it follows the mode, the theme and the corner shape the
// page is in; the colors whose custom property is not plain rgb channels,
// and the sizing steps, which have none, show their value instead.
import {
  colorOf,
  easePath,
  easeTrack,
  formatResolved,
  formatValue,
  previewOf,
  type Token,
} from '../lib/tokens.mjs';

interface Props {
  token: Token;
}

const { token } = Astro.props;
const { t } = Astro.locals;
const kind = previewOf(token);
const css = token.css;
// The value as a fallback: a token whose stylesheet the page does not load
// (the elevations of styles' theme.css) still shows what it draws.
const value = css ? `var(${css}, ${formatResolved(token)})` : formatValue(token);

// The squircle radius steps are tuned for that shape; the Magma radius scale
// takes the shape of the page's corner axis.
const shape = token.name.startsWith('radius.squircle')
  ? 'squircle'
  : token.group === 'magma.radius'
    ? 'var(--magma-corner-shape)'
    : 'round';
---

{kind === 'color' && (
  <span
    class="block size-800 rounded-md shadow-outline-weak"
    style={`background: ${token.live ? `rgb(var(${css}))` : colorOf(token)}`}
  ></span>
)}
{kind === 'shadow' && (
  <span class="flex size-1000 rounded-md bg-surface-overlay" style={`box-shadow: ${value}`}></span>
)}
{kind === 'font' && (
  <span class="block text-[1.5rem] leading-none text-fg-default" style={`font-family: ${value}`}>
    Aa
  </span>
)}
{kind === 'ease' && (
  <span class="flex size-1600 flex-col gap-100 rounded-md bg-wash-soft p-150">
    <svg
      class="block min-h-0 w-full flex-1 overflow-visible text-accent-fg"
      viewBox="-0.1 -0.4 1.2 1.8"
      aria-hidden="true"
    >
      <path
        d="M0 1H1V0"
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.2"
        vector-effect="non-scaling-stroke"
      />
      <path
        d={easePath(token)}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    <span class="@container block">
      <span
        class="block size-200 rounded-full bg-fg-default"
        style={`--preview-duration: var(--duration-1000, 1000ms); --preview-ease: ${value}`}
        data-motion-dot="1000ms"
        data-ease={formatResolved(token)}
        data-from={easeTrack(token).from}
        data-to={easeTrack(token).to}
      ></span>
    </span>
  </span>
)}
{kind === 'duration' && (
  <span class="@container flex size-1000 items-center rounded-md bg-wash-soft p-100">
    <span
      class="block size-200 rounded-full bg-fg-default"
      style={`--preview-duration: ${value}`}
      data-motion-dot={formatResolved(token)}
    ></span>
  </span>
)}
{kind === 'space' && (
  <span
    class="block h-200 max-w-2000 rounded-full bg-accent-emphasis"
    style={`width: ${value}`}
  ></span>
)}
{kind === 'radius' && (
  <span
    class="flex size-1000 border-2 border-solid border-current bg-surface-overlay"
    style={`border-radius: ${value}; corner-shape: ${shape}`}
  ></span>
)}
{kind === 'border' && (
  <span
    class="block w-1000 text-fg-default"
    style={`border-top: ${value} solid currentColor`}
  ></span>
)}
{kind === 'aspect' && (
  <span
    class="block h-800 rounded-sm bg-accent-surface shadow-outline-weak"
    style={`aspect-ratio: ${value}`}
  ></span>
)}
{kind === 'outline' && (
  <span
    class="m-100 block size-600 rounded-sm bg-surface-raised"
    style={`outline: ${value}`}
  ></span>
)}
{kind === 'opacity' && (
  <span class="block size-800 rounded-md bg-fg-default" style={`opacity: ${value}`}></span>
)}
{!kind && (
  <span
    class="flex size-800 items-center justify-center rounded-md bg-wash-soft"
    title={t('tokens.preview.none')}
  >
    <mds-text typography="caption" tag="span" class="my-0 whitespace-nowrap text-fg-subtle">
      {t('tokens.preview.na')}
    </mds-text>
  </span>
)}

<script>
  // The dot of a duration or an easing preview moves as a transition does:
  // once, across its track (`@container`), in the duration of
  // `--preview-duration` with the easing of `--preview-ease` (linear for a
  // duration; the slowest duration for an easing, to see its curve), from
  // `data-from` to `data-to`, the overshoot of an easing included. Then it
  // rests at the end, fades and starts over. Until the page resolves the
  // custom properties of the tokens, their values (`data-motion-dot`,
  // `data-ease`). Still when animations are reduced, by the system or by
  // Magma's preference class.
  const FADE = 200;
  const REST = 400;
  const HOLD = 1000;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const reduced = () =>
    reduce.matches || document.documentElement.classList.contains('pref-animation-reduce');
  /** A CSS time in milliseconds. */
  const ms = (time: string) => parseFloat(time) * (/\dms$/.test(time.trim()) ? 1 : 1000);
  /** A point of the track, as a fraction of it. */
  const at = (fraction: number) => `calc((100cqw - 100%) * ${fraction}) 0`;

  const start = () => {
    for (const dot of document.querySelectorAll<HTMLElement>('[data-motion-dot]')) {
      for (const animation of dot.getAnimations()) animation.cancel();
      const style = getComputedStyle(dot);
      const duration =
        ms(style.getPropertyValue('--preview-duration')) || ms(dot.dataset.motionDot ?? '');
      if (reduced() || !(duration >= 0)) continue;
      const easing =
        style.getPropertyValue('--preview-ease').trim() || dot.dataset.ease || 'linear';
      const from = at(Number(dot.dataset.from ?? 0));
      const to = at(Number(dot.dataset.to ?? 1));
      const total = FADE + REST + duration + HOLD + FADE;
      const offset = (time: number) => time / total;
      dot.animate(
        [
          { offset: 0, translate: from, opacity: 0 },
          { offset: offset(FADE), translate: from, opacity: 1 },
          { offset: offset(FADE + REST), translate: from, opacity: 1, easing },
          { offset: offset(FADE + REST + duration), translate: to, opacity: 1 },
          { offset: offset(total - FADE), translate: to, opacity: 1 },
          { offset: 1, translate: to, opacity: 0 },
        ],
        { duration: total, iterations: Infinity },
      );
    }
  };

  // Every page the router shows, the first one included.
  document.addEventListener('astro:page-load', start);
  reduce.addEventListener('change', start);
  start();
</script>
