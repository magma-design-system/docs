---
// A UI string (src/content/i18n/) with inline code: the parts between
// backticks become Code, as in Markdown. The dictionaries stay plain text,
// readable and easy to translate. `reading`: in the text to read (Code).
import Code from './Code.astro';

interface Props {
  text: string;
  reading?: boolean;
}

const { text, reading = false } = Astro.props;
const parts = text.split('`');
---

{parts.map((part, i) => (i % 2 === 1 ? <Code reading={reading}>{part}</Code> : part))}
