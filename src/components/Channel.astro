---
// A communication channel of Magma, as mds-card: in the header, the channel as
// mds-entity (its icon, its name and what it is) and a button that opens it in
// a new tab; below, what it is for (the slot). Inside Channels.astro.
// `variant` and `tone` color the icon of the entity: the values mds-entity
// accepts, typed by the installed Magma.
import type {
  ThemeFullVariantAvatarType,
  ToneMinimalVariantType,
} from '@maggioli-design-system/magma';

interface Props {
  name: string;
  kind: string;
  /** An mds-icon slug, collected by iconsauce from the page that uses it. */
  icon: string;
  href: string;
  action: string;
  variant?: ThemeFullVariantAvatarType;
  tone?: ToneMinimalVariantType;
}

const { name, kind, icon, href, action, variant, tone = 'weak' } = Astro.props;
---

<mds-card>
  <mds-card-header class="items-start">
    <mds-entity icon={icon} variant={variant} tone={tone}>
      <mds-text typography="h6" tag="h3">
        {name}
      </mds-text>
      <mds-text slot="detail" typography="caption">
        {kind}
      </mds-text>
    </mds-entity>
    <mds-button
      slot="action"
      href={href}
      target="blank"
      role="link"
      label={action}
      icon="mi/baseline/open-in-new"
      icon-position="right"
      variant="primary"
      size="lg"
      tone="text"
    ></mds-button>
  </mds-card-header>
  <mds-card-content class="pt-0">
    <mds-text>
      <slot />
    </mds-text>
  </mds-card-content>
</mds-card>
