---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Code from '../../../../components/Code.astro';
import CopyStatus from '../../../../components/CopyStatus.astro';
import Heading from '../../../../components/Heading.astro';
import CopyToClipboard from '../../../../components/CopyToClipboard.astro';
import Playground from '../../../../components/Playground.astro';
import TypeLabels from '../../../../components/TypeLabels.astro';
import UiText from '../../../../components/UiText.astro';
import { componentHref, pagesOf, type ComponentPage } from '../../../../lib/components';
import { propControl } from '../../../../lib/controls';
import { localeParams } from '../../../../lib/i18n.mjs';
import { READING, TEXT } from '../../../../lib/markdown-text.mjs';
import { componentName } from '../../../../lib/nav.mjs';
import { typeSortValue, unquote } from '../../../../lib/types';

// One page per component and sub-page (src/lib/components.ts): the main page
// (overview) and the sub-pages documentation.json has data for.
export async function getStaticPaths() {
  const components = await getCollection('components');
  return localeParams.flatMap((locale) =>
    components.flatMap((entry) =>
      pagesOf(entry.data).map((page) => ({
        params: { locale, tag: entry.id, page: page.slug },
        props: { entry, page },
      })),
    ),
  );
}

interface Props {
  entry: CollectionEntry<'components'>;
  page: ComponentPage;
}

const { data } = Astro.props.entry;
const { page } = Astro.props;
const { locale } = Astro.params;
const { t } = Astro.locals;
const link = (tag: string) => componentHref(locale, tag);

// What comes from the Magma packages is in English only (the header says so,
// src/components/frame/PageTitle.astro).
const contentLang = locale ? 'en' : undefined;

// The <title> of the page. What the page shows is the component's header
// (src/components/frame/PageTitle.astro).
const name = componentName(data.tag);
const title = page.id === 'overview' ? name : `${name} ${t(page.label)}`;
// Pattern and Antipattern pages are a usage file each, headings included.
const guide = page.id === 'pattern' || page.id === 'antipattern' ? data[page.id] : undefined;

const sections = {
  overview: [
    // The preview's controls (Playground.astro).
    {
      id: 'props',
      label: t('component.props'),
      show: data.example !== '' && data.props.some((prop) => propControl(prop) !== undefined),
    },
    { id: 'overview', label: t('component.overview'), show: true },
    {
      id: 'dependencies',
      label: t('component.dependencies'),
      show: data.dependencies.length > 0 || data.dependents.length > 0,
    },
  ],
  api: [
    { id: 'props', label: t('component.props'), show: data.props.length > 0 },
    { id: 'events', label: t('component.events'), show: data.events.length > 0 },
    { id: 'methods', label: t('component.methods'), show: data.methods.length > 0 },
    { id: 'slots', label: t('component.slots'), show: data.slots.length > 0 },
  ],
  css: [
    {
      id: 'css-custom-properties',
      label: t('component.cssCustomProperties'),
      show: data.styles.length > 0,
    },
    { id: 'parts', label: t('component.parts'), show: data.parts.length > 0 },
  ],
  pattern: [],
  antipattern: [],
}[page.id].filter((section) => section.show);
const label = (id: string) => sections.find((section) => section.id === id)?.label;

// What slots are, then only what applies to this component's slots.
const namedSlot = data.slots.find((slot) => slot.name)?.name;
const slotsIntro = [
  t('component.slots.intro'),
  data.slots.some((slot) => !slot.name) && t('component.slots.default'),
  data.slots.some((slot) => !slot.name) &&
    data.props.some((prop) => prop.name === 'label') &&
    t('component.slots.label'),
  // Astro escapes the text: i18next does not need to.
  namedSlot &&
    t('component.slots.named', { name: namedSlot, interpolation: { escapeValue: false } }),
].filter(Boolean);

const headings =
  guide?.headings ??
  sections.map((section) => ({ depth: 2, slug: section.id, text: section.label }));

// Table cells stay on one line: mds-table scrolls sideways when it is wider
// than the page. Descriptions wrap instead, at Magma's reading measure
// (--spacing-text). `min-w-text`, not `w-text`: on a table cell the width is
// only the preferred one, and Chrome squeezes the column to its longest word.
const CELL = 'whitespace-nowrap';
const DESCRIPTION = 'min-w-phrase';
---

<StarlightPage frontmatter={{ title, description: data.summary }} headings={headings}>
  {page.id === 'overview' && data.example !== '' && (
    <Playground tag={data.tag} props={data.props} example={data.example} />
  )}

  {page.id === 'overview' && (
    <>
      <Heading id="overview" typography="h3" text={label('overview') ?? ''} />
      <div lang={contentLang} set:html={data.descriptionHtml} />

      {label('dependencies') && (
        <>
          <Heading id="dependencies" typography="h3" text={label('dependencies') ?? ''} />
          {data.dependencies.length > 0 && (
            <mds-text {...READING} tag="p" class={TEXT.paragraph}>
              {t('component.uses')}:{' '}
              {data.dependencies.map((tag, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={link(tag)}>
                    <Code reading>{tag}</Code>
                  </a>
                </>
              ))}
            </mds-text>
          )}
          {data.dependents.length > 0 && (
            <mds-text {...READING} tag="p" class={TEXT.paragraph}>
              {t('component.usedBy')}:{' '}
              {data.dependents.map((tag, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={link(tag)}>
                    <Code reading>{tag}</Code>
                  </a>
                </>
              ))}
            </mds-text>
          )}
        </>
      )}
    </>
  )}

  {guide && <div lang={contentLang} set:html={guide.html} />}

  {page.id === 'api' && (
    <mds-text {...READING} tag="p" class={TEXT.paragraph}>
      <UiText reading text={t('component.api.intro')} />
    </mds-text>
  )}

  {page.id === 'api' && data.props.length > 0 && (
    <>
      <Heading id="props" typography="h3" text={label('props') ?? ''} />
      <mds-text {...READING} tag="p" class={TEXT.paragraph}>
        <UiText reading text={t('component.api.props')} />
      </mds-text>
      <mds-table interactive>
        <mds-table-header>
          {/* Sorted by each cell's `value`: what the cell shows, as text. */}
          <mds-table-header-cell label={t('component.column.property')} sortable />
          <mds-table-header-cell label={t('component.column.attribute')} sortable />
          <mds-table-header-cell label={t('component.column.type')} sortable />
          <mds-table-header-cell label={t('component.column.default')} sortable />
          <mds-table-header-cell label={t('component.column.description')} />
        </mds-table-header>
        <mds-table-body>
          {data.props.map((p: any) => (
            <mds-table-row data-copy-scope>
              <mds-table-cell class={CELL} value={p.name}>
                <Code name copy={p.name}>
                  {p.name}
                </Code>
                {p.required && ` (${t('component.required')})`}
              </mds-table-cell>
              {/* A dash when it is the name itself, so the ones that differ stand out. */}
              <mds-table-cell class={CELL} value={p.attr === p.name ? '-' : (p.attr ?? '')}>
                {p.attr === p.name ? (
                  <mds-text typography="hack" tag="span" class="text-fg-muted">
                    -
                  </mds-text>
                ) : (
                  p.attr && (
                    <Code name copy={p.attr}>
                      {p.attr}
                    </Code>
                  )
                )}
              </mds-table-cell>
              <mds-table-cell class={CELL} value={typeSortValue(p.type)}>
                <TypeLabels type={p.type} />
              </mds-table-cell>
              <mds-table-cell
                class={CELL}
                value={p.default !== undefined ? unquote(p.default) : ''}
              >
                {p.default !== undefined && (
                  <Code copy={unquote(p.default)}>{unquote(p.default)}</Code>
                )}
              </mds-table-cell>
              <mds-table-cell class={DESCRIPTION} lang={contentLang} set:html={p.docsHtml} />
              <CopyStatus />
            </mds-table-row>
          ))}
        </mds-table-body>
      </mds-table>
    </>
  )}

  {page.id === 'api' && data.events.length > 0 && (
    <>
      <Heading id="events" typography="h3" text={label('events') ?? ''} />
      <mds-table interactive>
        <mds-table-header>
          <mds-table-header-cell label={t('component.column.event')} />
          <mds-table-header-cell label={t('component.column.detail')} />
          <mds-table-header-cell label={t('component.column.description')} />
        </mds-table-header>
        <mds-table-body>
          {data.events.map((e: any) => (
            <mds-table-row data-copy-scope>
              <mds-table-cell class={CELL}>
                <Code name copy={e.event}>
                  {e.event}
                </Code>
              </mds-table-cell>
              <mds-table-cell class={CELL}>
                <Code copy={e.detail}>{e.detail}</Code>
              </mds-table-cell>
              <mds-table-cell class={DESCRIPTION} lang={contentLang} set:html={e.docsHtml} />
              <CopyStatus />
            </mds-table-row>
          ))}
        </mds-table-body>
      </mds-table>
    </>
  )}

  {page.id === 'api' && data.methods.length > 0 && (
    <>
      <Heading id="methods" typography="h3" text={label('methods') ?? ''} />
      <mds-table interactive>
        <mds-table-header>
          <mds-table-header-cell label={t('component.column.method')} />
          <mds-table-header-cell label={t('component.column.signature')} />
          <mds-table-header-cell label={t('component.column.description')} />
        </mds-table-header>
        <mds-table-body>
          {data.methods.map((m: any) => (
            <mds-table-row data-copy-scope>
              <mds-table-cell class={CELL}>
                <Code name copy={m.name}>
                  {m.name}
                </Code>
              </mds-table-cell>
              <mds-table-cell class={CELL}>
                <Code copy={m.signature}>{m.signature}</Code>
              </mds-table-cell>
              <mds-table-cell class={DESCRIPTION} lang={contentLang} set:html={m.docsHtml} />
              <CopyStatus />
            </mds-table-row>
          ))}
        </mds-table-body>
      </mds-table>
    </>
  )}

  {[
    { page: 'api', id: 'slots', column: t('component.column.slot'), items: data.slots },
    {
      page: 'css',
      id: 'css-custom-properties',
      column: t('component.column.name'),
      items: data.styles,
    },
    { page: 'css', id: 'parts', column: t('component.column.part'), items: data.parts },
  ]
    .filter((section) => section.page === page.id && section.items.length > 0)
    .map((section) => (
      <>
        <Heading id={section.id} typography="h3" text={label(section.id) ?? ''} />
        {section.id === 'slots' && (
          <mds-text {...READING} tag="p" class={TEXT.paragraph}>
            <UiText reading text={slotsIntro.join(' ')} />
          </mds-text>
        )}
        <mds-table interactive>
          <mds-table-header>
            <mds-table-header-cell label={section.column} />
            <mds-table-header-cell label={t('component.column.description')} />
          </mds-table-header>
          <mds-table-body>
            {section.items.map((item) => (
              <mds-table-row data-copy-scope>
                <mds-table-cell class={CELL}>
                  {/* The default slot has no name to copy. */}
                  <Code name copy={item.name || undefined}>
                    {item.name || t('component.defaultSlot')}
                  </Code>
                </mds-table-cell>
                <mds-table-cell class={DESCRIPTION} lang={contentLang} set:html={item.docsHtml} />
                {/* The default slot has nothing to copy: a note keeps its action cell. */}
                <CopyStatus note={item.name ? undefined : t('component.defaultSlotAction')} />
              </mds-table-row>
            ))}
          </mds-table-body>
        </mds-table>
      </>
    ))}

  {/* Values of the tables are copied when clicked (not the descriptions); each row says so. */}
  {(page.id === 'api' || page.id === 'css') && <CopyToClipboard />}
</StarlightPage>
