---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { localeParams } from '../../../lib/i18n.mjs';
import { magmaVersion } from '../../../lib/magma.mjs';

export async function getStaticPaths() {
  const components = await getCollection('components');
  return localeParams.flatMap((locale) =>
    components.map((entry) => ({ params: { locale, tag: entry.id }, props: { entry } })),
  );
}

interface Props {
  entry: CollectionEntry<'components'>;
}

const { data } = Astro.props.entry;
const { locale } = Astro.params;
const { t } = Astro.locals;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (tag: string) => `${base}${locale ? `/${locale}` : ''}/components/${tag}/`;

// Everything below the notice comes from the Magma packages, in English only.
const contentLang = locale ? 'en' : undefined;

const api = [
  { id: 'props', label: t('component.props'), show: data.props.length > 0 },
  { id: 'events', label: t('component.events'), show: data.events.length > 0 },
  { id: 'methods', label: t('component.methods'), show: data.methods.length > 0 },
  { id: 'slots', label: t('component.slots'), show: data.slots.length > 0 },
  { id: 'css-custom-properties', label: t('component.cssCustomProperties'), show: data.styles.length > 0 },
  { id: 'parts', label: t('component.parts'), show: data.parts.length > 0 },
].filter((section) => section.show);
const apiLabel = (id: string) => api.find((section) => section.id === id)?.label;

const headings = [
  { depth: 2, slug: 'overview', text: t('component.overview') },
  ...(data.usage.length ? [{ depth: 2, slug: 'usage', text: t('component.usage') }] : []),
  ...data.usage.map((u) => ({ depth: 3, slug: `usage-${u.title.toLowerCase()}`, text: u.title })),
  ...(api.length ? [{ depth: 2, slug: 'api', text: t('component.api') }] : []),
  ...api.map((s) => ({ depth: 3, slug: s.id, text: s.label })),
  ...(data.dependencies.length || data.dependents.length
    ? [{ depth: 2, slug: 'dependencies', text: t('component.dependencies') }]
    : []),
];
---

<StarlightPage frontmatter={{ title: `<${data.tag}>`, description: data.summary }} headings={headings}>
  <p class="built-against">
    {t('component.generatedFrom')} <code>@maggioli-design-system/magma@{magmaVersion()}</code>
    <code>dist/documentation.json</code>. {t('component.encapsulation')}: <code>{data.encapsulation}</code>.
    {locale && <><br />{t('component.sourceLanguage')}</>}
  </p>

  <h2 id="overview">{t('component.overview')}</h2>
  <div lang={contentLang} set:html={data.readmeHtml} />

  {
    data.usage.length > 0 && (
      <>
        <h2 id="usage">{t('component.usage')}</h2>
        {data.usage.map((u) => (
          <div lang={contentLang}>
            <h3 id={`usage-${u.title.toLowerCase()}`}>{u.title}</h3>
            <Fragment set:html={u.html} />
          </div>
        ))}
      </>
    )
  }

  {api.length > 0 && <h2 id="api">{t('component.api')}</h2>}

  {
    data.props.length > 0 && (
      <>
        <h3 id="props">{apiLabel('props')}</h3>
        <table>
          <thead>
            <tr>
              <th>{t('component.column.property')}</th>
              <th>{t('component.column.type')}</th>
              <th>{t('component.column.description')}</th>
            </tr>
          </thead>
          <tbody>
            {data.props.map((p: any) => (
              <tr>
                <td>
                  <code>{p.name}</code>{p.required && ` (${t('component.required')})`}
                  {p.attr && p.attr !== p.name && <><br />{t('component.attribute')}: <code>{p.attr}</code></>}
                </td>
                <td>
                  <code>{p.type}</code>
                  {p.default !== undefined && <><br />{t('component.default')}: <code>{p.default}</code></>}
                </td>
                <td lang={contentLang} set:html={p.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    data.events.length > 0 && (
      <>
        <h3 id="events">{apiLabel('events')}</h3>
        <table>
          <thead>
            <tr>
              <th>{t('component.column.event')}</th>
              <th>{t('component.column.detail')}</th>
              <th>{t('component.column.description')}</th>
            </tr>
          </thead>
          <tbody>
            {data.events.map((e: any) => (
              <tr>
                <td><code>{e.event}</code></td>
                <td><code>{e.detail}</code></td>
                <td lang={contentLang} set:html={e.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    data.methods.length > 0 && (
      <>
        <h3 id="methods">{apiLabel('methods')}</h3>
        <table>
          <thead>
            <tr>
              <th>{t('component.column.method')}</th>
              <th>{t('component.column.signature')}</th>
              <th>{t('component.column.description')}</th>
            </tr>
          </thead>
          <tbody>
            {data.methods.map((m: any) => (
              <tr>
                <td><code>{m.name}</code></td>
                <td><code>{m.signature}</code></td>
                <td lang={contentLang} set:html={m.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    [
      { id: 'slots', column: t('component.column.slot'), items: data.slots },
      { id: 'css-custom-properties', column: t('component.column.name'), items: data.styles },
      { id: 'parts', column: t('component.column.part'), items: data.parts },
    ]
      .filter((section) => section.items.length > 0)
      .map((section) => (
        <>
          <h3 id={section.id}>{apiLabel(section.id)}</h3>
          <table>
            <thead>
              <tr>
                <th>{section.column}</th>
                <th>{t('component.column.description')}</th>
              </tr>
            </thead>
            <tbody>
              {section.items.map((item) => (
                <tr>
                  <td><code>{item.name || t('component.defaultSlot')}</code></td>
                  <td lang={contentLang} set:html={item.docsHtml} />
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))
  }

  {
    (data.dependencies.length > 0 || data.dependents.length > 0) && (
      <>
        <h2 id="dependencies">{t('component.dependencies')}</h2>
        {data.dependencies.length > 0 && (
          <p>
            {t('component.uses')}:{' '}
            {data.dependencies.map((tag, i) => (
              <>{i > 0 && ', '}<a href={link(tag)}><code>{tag}</code></a></>
            ))}
          </p>
        )}
        {data.dependents.length > 0 && (
          <p>
            {t('component.usedBy')}:{' '}
            {data.dependents.map((tag, i) => (
              <>{i > 0 && ', '}<a href={link(tag)}><code>{tag}</code></a></>
            ))}
          </p>
        )}
      </>
    )
  }
</StarlightPage>

<style>
  .built-against {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
