---
// Landing page of the Components section: every component, linking to its page.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import Code from '../../../components/Code.astro';
import { componentHref } from '../../../lib/components';
import { TEXT } from '../../../lib/markdown-text.mjs';
import { localeParams } from '../../../lib/i18n.mjs';
import { componentName } from '../../../lib/nav.mjs';

export function getStaticPaths() {
  return localeParams.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = Astro.locals;
const components = (await getCollection('components')).sort((a, b) => a.id.localeCompare(b.id));
---

<StarlightPage
  frontmatter={{ title: t('components.title'), description: t('components.description') }}
>
  <mds-text typography="detail" tag="p" class={TEXT.paragraph}>
    {t('components.description')}
  </mds-text>
  {/* mds-list is a grid: columns of the grid, filled row by row. */}
  <mds-list class="grid-cols-[repeat(auto-fill,minmax(--spacing(6000),1fr))]">
    {components.map(({ id }) => (
      <mds-list-item typography="detail" class={TEXT.listItem}>
        <a href={componentHref(locale, id)}>{componentName(id)}</a> <Code>{`<${id}>`}</Code>
      </mds-list-item>
    ))}
  </mds-list>
</StarlightPage>
