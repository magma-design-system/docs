---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { localeParams } from '../../../lib/i18n.mjs';

// One page per domain of the design language the installed magma ships
// (src/loaders/domains.ts), in every language: the whole file, as the agents
// read it. The header says where it comes from (src/components/frame/PageTitle.astro).
export async function getStaticPaths() {
  const domains = await getCollection('domains');
  return localeParams.flatMap((locale) =>
    domains.map((entry) => ({ params: { locale, domain: entry.id }, props: { entry } })),
  );
}

interface Props {
  entry: CollectionEntry<'domains'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { locale } = Astro.params;
const { t } = Astro.locals;
// The name of the domain in the language of the page, as the navigation has it.
const title = t(`nav.foundation.${entry.id}` as any);
// What comes from the Magma packages is in English only (the header says so).
const contentLang = locale ? 'en' : undefined;
// The table of contents: the sections of the file (Cases, Always true, ...).
const headings = data.headings.filter((heading) => heading.depth <= 3);
---

<StarlightPage frontmatter={{ title, description: data.need }} headings={headings}>
  <div lang={contentLang} set:html={data.html} />
</StarlightPage>
