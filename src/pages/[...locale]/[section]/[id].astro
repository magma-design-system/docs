---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import PatternAgent from '../../../components/PatternAgent.astro';
import PatternStage from '../../../components/PatternStage.astro';
import PreviewZoom from '../../../components/PreviewZoom.astro';
import { localeParams } from '../../../lib/i18n.mjs';
import { READING, TEXT } from '../../../lib/markdown-text.mjs';
import { PATTERN_SECTIONS } from '../../../lib/nav.mjs';

// One page per file of agents/patterns/ of the installed magma
// (src/loaders/patterns.ts), in every language, in the section of its kind: a
// domain under Design language, a pattern under Patterns, a building block
// under Building blocks. The working case first, the reasons after: the need
// in one line, then the stage that runs its previews one at a time, the first
// case at the start (PatternStage.astro), then, for a decided pattern or
// block, how to apply it with an AI agent, then the whole file as the agents
// read it, where the id of a preview links back to the stage. The header says
// where it comes from (src/components/frame/PageTitle.astro).
export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return localeParams.flatMap((locale) =>
    patterns.map((entry) => ({
      params: { locale, section: PATTERN_SECTIONS[entry.data.kind], id: entry.id },
      props: { entry },
    })),
  );
}

interface Props {
  entry: CollectionEntry<'patterns'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { locale } = Astro.params;
const { t } = Astro.locals;
// A domain is named in the language of the page, as the navigation has it; a
// pattern or a block by its title, as the package writes it.
const title = data.kind === 'foundation' ? t(`nav.design-language.${entry.id}` as any) : data.title;
// What comes from the Magma packages is in English only (the header says so).
const contentLang = locale ? 'en' : undefined;
const staged = data.previews.length > 0;
// The table of contents: the stage, then the sections of the file (Cases,
// Always true, ...).
const headings = [
  ...(staged ? [{ depth: 2, slug: 'try', text: t('pattern.stage.title') }] : []),
  ...data.headings.filter((heading) => heading.depth <= 3),
];
---

<StarlightPage frontmatter={{ title, description: data.need }} headings={headings}>
  <mds-text {...READING} tag="p" class={TEXT.paragraph} lang={contentLang}>
    {data.need}
  </mds-text>
  {staged && (
    <PatternStage
      kind={data.kind}
      id={entry.id}
      previews={data.previews}
      contentLang={contentLang}
    />
  )}
  {data.kind !== 'foundation' && data.status === 'decided' && (
    <PatternAgent kind={data.kind} id={entry.id} locale={locale} />
  )}
  <div lang={contentLang} set:html={data.html} />
  {staged && <PreviewZoom />}
</StarlightPage>
