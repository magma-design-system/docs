---
// A page to check how the anchor of a heading (ANCHOR and TEXT.anchorLine in
// src/lib/markdown-text.mjs, Heading.astro) lines up with it: every title
// size, on one line and on more, with the site's classes, next to the other
// ways to align the button. Dev only: the build gets no page.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Code from '../../components/Code.astro';
import { ANCHOR, TEXT } from '../../lib/markdown-text.mjs';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { name: 'heading-anchors' } }] : [];
}

/** The title sizes. `auto`: the button size that fits the line. */
const SIZES = [
  { typography: 'h1', auto: 'lg' },
  { typography: 'h2', auto: 'md' },
  { typography: 'h3', auto: 'md' },
  { typography: 'h4', auto: 'sm' },
  { typography: 'h5', auto: 'sm' },
  { typography: 'h6', auto: 'sm' },
] as const;

const TITLES = [
  { key: 'short', text: 'Reading the tables', narrow: false },
  {
    key: 'long',
    text: 'Semantic aliases, primitive ramps and the themes that switch them while the page is running',
    narrow: false,
  },
  { key: 'narrow', text: 'Typography, spacing and quite a long heading', narrow: true },
];

const ALIGNMENTS = [
  { value: 'line', label: 'First line, center (site)' },
  { value: 'cap', label: 'First line, cap height' },
  { value: 'top', label: 'Top edge (before)' },
  { value: 'block', label: 'Whole heading, center' },
];

const BUTTON_SIZES = ['auto', 'sm', 'md', 'lg', 'xl'];
---

<StarlightPage frontmatter={{ title: 'Heading anchors', pagefind: false }} headings={[]}>
  <div data-lab data-align="line" class="flex flex-col gap-1000">
    <div class="not-content flex flex-wrap items-end gap-600">
      <mds-input-field label="Alignment" class="w-6400">
        <mds-input-select data-lab-control="align" class="mt-0">
          {ALIGNMENTS.map(({ value, label }) => (
            <option value={value}>{label}</option>
          ))}
        </mds-input-select>
      </mds-input-field>
      <mds-input-field label="Button size" class="w-3200">
        <mds-input-select data-lab-control="size" class="mt-0">
          {BUTTON_SIZES.map((size) => (
            <option value={size}>{size}</option>
          ))}
        </mds-input-select>
      </mds-input-field>
      <mds-input-switch type="switch" data-lab-control="guides">
        Guides
      </mds-input-switch>
    </div>

    <mds-list class="not-content">
      <mds-list-item typography="detail" class={TEXT.listItem}>
        <strong>First line, center (site)</strong>: the site's classes. A box with the heading's
        typography and one invisible character stands for the first line; the button is centered on
        it. h4 to h6 keep half the space from the text, h6 one step higher.
      </mds-list-item>
      <mds-list-item typography="detail" class={TEXT.listItem}>
        <strong>First line, cap height</strong>: the same box trimmed to the capital letters (
        <Code>text-box: trim-both cap alphabetic</Code>), on the heading's baseline: the button is
        centered on the capitals.
      </mds-list-item>
      <mds-list-item typography="detail" class={TEXT.listItem}>
        <strong>Top edge (before)</strong>: the button keeps the top of the heading box, which Magma
        trims to the top of the letters (<Code>text-box: trim-both text</Code>), so it sits higher
        than the text.
      </mds-list-item>
      <mds-list-item typography="detail" class={TEXT.listItem}>
        <strong>Whole heading, center</strong>: the button in the middle of the heading, for
        comparison only.
      </mds-list-item>
    </mds-list>

    <mds-text typography="caption" tag="p" class={TEXT.paragraph}>
      Under each heading: how far the center of the button is from the center of the capital letters
      and from the center of the first line, in pixels (positive: the button is lower). With guides
      on, the dashed box is the heading and the line crosses the center of the button.
    </mds-text>

    {SIZES.map(({ typography, auto }) => (
      <section class="not-content flex flex-col gap-600 border-t border-wash-soft pt-600">
        <mds-text typography="label" tag="p" class="text-fg-weak">
          {typography}
        </mds-text>
        {TITLES.map(({ key, text, narrow }) => {
          const id = `lab-${typography}-${key}`;
          return (
            <div class:list={['flex flex-col gap-200', narrow && 'max-w-7200']}>
              <div class="lab-row flex items-start" data-lab-row data-auto-size={auto}>
                <span class:list={['lab-strut', TEXT.anchorLine[typography]]}>
                  <mds-button
                    href={`#${id}`}
                    {...ANCHOR}
                    size={auto}
                    aria-label={`Section titled "${text}"`}
                  />
                </span>
                <mds-text id={id} typography={typography} tag="h2" class={TEXT.headingText}>
                  {text}
                </mds-text>
              </div>
              <mds-text typography="caption" tag="p" class="text-fg-weak" data-lab-delta>
                -
              </mds-text>
            </div>
          );
        })}
      </section>
    ))}
  </div>
</StarlightPage>

<style is:global>
  /*
    The rows use the site's classes (TEXT.anchorLine, ANCHOR): "line" needs no
    rule. The other alignments undo them. Sizes come from Magma's spacing
    (var(--spacing), what --spacing() gives in the site's CSS).
  */
  [data-lab] .lab-row {
    overflow-x: clip;
  }

  [data-lab] .lab-strut {
    position: relative;
  }

  [data-lab][data-align='cap'] .lab-row {
    align-items: baseline;
  }

  [data-lab][data-align='cap'] .lab-strut::before {
    text-box: trim-both cap alphabetic;
  }

  [data-lab]:is([data-align='top'], [data-align='block']) .lab-strut::before {
    content: none;
  }

  [data-lab]:is([data-align='top'], [data-align='block']) .lab-strut > mds-button {
    margin-block: 0;
    translate: none;
  }

  [data-lab][data-align='top'] .lab-strut > mds-button {
    align-self: flex-start;
  }

  [data-lab][data-align='block'] .lab-row {
    align-items: center;
  }

  /* Guides: the heading's box, the button's box and its center line. */
  [data-lab][data-guides] .lab-row > mds-text {
    outline: calc(var(--spacing) * 25) dashed rgb(var(--label-blue-06));
  }

  [data-lab][data-guides] .lab-strut > mds-button {
    outline: calc(var(--spacing) * 25) solid rgb(var(--label-red-06));
  }

  [data-lab][data-guides] .lab-strut::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100vw;
    border-top: calc(var(--spacing) * 25) solid rgb(var(--label-red-06));
    content: '';
    pointer-events: none;
  }
</style>

<script>
  const lab = document.querySelector<HTMLElement>('[data-lab]');
  const context = document.createElement('canvas').getContext('2d');

  /** The ascent of the font of an element and the height of its capitals. */
  const metrics = (element: Element) => {
    const style = getComputedStyle(element);
    context!.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const capital = context!.measureText('H');
    return { ascent: capital.fontBoundingBoxAscent, cap: capital.actualBoundingBoxAscent };
  };

  const signed = (value: number) => `${value > 0 ? '+' : ''}${value.toFixed(1)}`;

  /** How far each button is from the capitals and from the first line. */
  const measure = () => {
    for (const row of lab?.querySelectorAll<HTMLElement>('[data-lab-row]') ?? []) {
      const button = row.querySelector('mds-button');
      const heading = row.querySelector('mds-text');
      const delta = row.parentElement?.querySelector('[data-lab-delta]');
      if (!button || !heading || !delta) continue;
      const range = document.createRange();
      range.selectNodeContents(heading);
      const lines = range.getClientRects();
      const line = lines[0];
      if (!line) continue;
      const box = button.getBoundingClientRect();
      const center = box.top + box.height / 2;
      const { ascent, cap } = metrics(heading);
      const capCenter = line.top + ascent - cap / 2;
      const lineCenter = line.top + line.height / 2;
      const gap = heading.getBoundingClientRect().left - box.right;
      delta.textContent =
        `caps ${signed(center - capCenter)} px, line ${signed(center - lineCenter)} px, ` +
        `gap ${gap.toFixed(1)} px (button ${box.height}px, line ${line.height.toFixed(1)}px, ` +
        `${lines.length} line${lines.length > 1 ? 's' : ''})`;
    }
  };

  // A timeout, not an animation frame: frames wait while the window is hidden.
  let timer: ReturnType<typeof setTimeout> | undefined;
  const later = () => {
    clearTimeout(timer);
    timer = setTimeout(measure, 50);
  };

  const state = new URLSearchParams(location.search);

  const apply = () => {
    if (!lab) return;
    lab.dataset.align = state.get('align') ?? 'line';
    lab.toggleAttribute('data-guides', state.has('guides'));
    const size = state.get('size') ?? 'auto';
    for (const row of lab.querySelectorAll<HTMLElement>('[data-lab-row]')) {
      row
        .querySelector('mds-button')
        ?.setAttribute('size', size === 'auto' ? (row.dataset.autoSize ?? 'md') : size);
    }
    history.replaceState(null, '', `${location.pathname}?${state}${location.hash}`);
    later();
  };

  const control = (name: string) =>
    lab?.querySelector<HTMLElement & { value?: string; checked?: boolean }>(
      `[data-lab-control="${name}"]`,
    );

  if (lab) {
    lab.addEventListener('mdsInputSelectChange', (event) => {
      const name = (event.target as HTMLElement).dataset.labControl;
      const value = (event as CustomEvent<{ value?: string }>).detail?.value;
      if (!name || !value) return;
      state.set(name, value);
      apply();
    });
    lab.addEventListener('mdsInputSwitchChange', (event) => {
      if ((event as CustomEvent<{ checked?: boolean }>).detail?.checked) state.set('guides', '');
      else state.delete('guides');
      apply();
    });

    Promise.all(
      ['mds-input-select', 'mds-input-switch'].map((tag) => customElements.whenDefined(tag)),
    ).then(() => {
      const align = control('align');
      const size = control('size');
      const guides = control('guides');
      if (align) align.value = state.get('align') ?? 'line';
      if (size) size.value = state.get('size') ?? 'auto';
      if (guides) guides.checked = state.has('guides');
    });

    const observer = new ResizeObserver(later);
    for (const element of lab.querySelectorAll('[data-lab-row], [data-lab-row] mds-button')) {
      observer.observe(element);
    }
    document.fonts.ready.then(later);
    apply();
  }
</script>
