---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { magmaVersion } from '../../lib/magma.mjs';

export async function getStaticPaths() {
  const components = await getCollection('components');
  return components.map((entry) => ({ params: { tag: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'components'>;
}

const { data } = Astro.props.entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (tag: string) => `${base}/components/${tag}/`;

const api = [
  { id: 'props', label: 'Props', show: data.props.length > 0 },
  { id: 'events', label: 'Events', show: data.events.length > 0 },
  { id: 'methods', label: 'Methods', show: data.methods.length > 0 },
  { id: 'slots', label: 'Slots', show: data.slots.length > 0 },
  { id: 'css-custom-properties', label: 'CSS custom properties', show: data.styles.length > 0 },
  { id: 'parts', label: 'Parts', show: data.parts.length > 0 },
].filter((section) => section.show);

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  ...(data.usage.length ? [{ depth: 2, slug: 'usage', text: 'Usage' }] : []),
  ...data.usage.map((u) => ({ depth: 3, slug: `usage-${u.title.toLowerCase()}`, text: u.title })),
  ...(api.length ? [{ depth: 2, slug: 'api', text: 'API' }] : []),
  ...api.map((s) => ({ depth: 3, slug: s.id, text: s.label })),
  ...(data.dependencies.length || data.dependents.length
    ? [{ depth: 2, slug: 'dependencies', text: 'Dependencies' }]
    : []),
];
---

<StarlightPage frontmatter={{ title: `<${data.tag}>`, description: data.summary }} headings={headings}>
  <p class="built-against">
    Generated from <code>@maggioli-design-system/magma@{magmaVersion()}</code>
    <code>dist/documentation.json</code>. Encapsulation: <code>{data.encapsulation}</code>.
  </p>

  <h2 id="overview">Overview</h2>
  <Fragment set:html={data.readmeHtml} />

  {
    data.usage.length > 0 && (
      <>
        <h2 id="usage">Usage</h2>
        {data.usage.map((u) => (
          <>
            <h3 id={`usage-${u.title.toLowerCase()}`}>{u.title}</h3>
            <Fragment set:html={u.html} />
          </>
        ))}
      </>
    )
  }

  {api.length > 0 && <h2 id="api">API</h2>}

  {
    data.props.length > 0 && (
      <>
        <h3 id="props">Props</h3>
        <table>
          <thead>
            <tr><th>Property</th><th>Type</th><th>Description</th></tr>
          </thead>
          <tbody>
            {data.props.map((p: any) => (
              <tr>
                <td>
                  <code>{p.name}</code>{p.required && ' (required)'}
                  {p.attr && p.attr !== p.name && <><br />attr: <code>{p.attr}</code></>}
                </td>
                <td><code>{p.type}</code>{p.default !== undefined && <><br />default: <code>{p.default}</code></>}</td>
                <td set:html={p.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    data.events.length > 0 && (
      <>
        <h3 id="events">Events</h3>
        <table>
          <thead>
            <tr><th>Event</th><th>Detail</th><th>Description</th></tr>
          </thead>
          <tbody>
            {data.events.map((e: any) => (
              <tr>
                <td><code>{e.event}</code></td>
                <td><code>{e.detail}</code></td>
                <td set:html={e.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    data.methods.length > 0 && (
      <>
        <h3 id="methods">Methods</h3>
        <table>
          <thead>
            <tr><th>Method</th><th>Signature</th><th>Description</th></tr>
          </thead>
          <tbody>
            {data.methods.map((m: any) => (
              <tr>
                <td><code>{m.name}</code></td>
                <td><code>{m.signature}</code></td>
                <td set:html={m.docsHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    [
      { id: 'slots', label: 'Slots', column: 'Slot', items: data.slots },
      { id: 'css-custom-properties', label: 'CSS custom properties', column: 'Name', items: data.styles },
      { id: 'parts', label: 'Parts', column: 'Part', items: data.parts },
    ]
      .filter((section) => section.items.length > 0)
      .map((section) => (
        <>
          <h3 id={section.id}>{section.label}</h3>
          <table>
            <thead>
              <tr><th>{section.column}</th><th>Description</th></tr>
            </thead>
            <tbody>
              {section.items.map((item) => (
                <tr>
                  <td><code>{item.name || '(default)'}</code></td>
                  <td set:html={item.docsHtml} />
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))
  }

  {
    (data.dependencies.length > 0 || data.dependents.length > 0) && (
      <>
        <h2 id="dependencies">Dependencies</h2>
        {data.dependencies.length > 0 && (
          <p>
            Uses:{' '}
            {data.dependencies.map((tag, i) => (
              <>{i > 0 && ', '}<a href={link(tag)}><code>{tag}</code></a></>
            ))}
          </p>
        )}
        {data.dependents.length > 0 && (
          <p>
            Used by:{' '}
            {data.dependents.map((tag, i) => (
              <>{i > 0 && ', '}<a href={link(tag)}><code>{tag}</code></a></>
            ))}
          </p>
        )}
      </>
    )
  }
</StarlightPage>

<style>
  .built-against {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
